// -----------------------------------------------------------------------------
// 0.10 expanded Itajai world layer.
// Replaces the small 0.5 cache/parser/fetch path while preserving the old code
// under *_legacy names for regression. The playable corridor now reaches from
// the port/Centro side through the coast toward Praia Brava.
// -----------------------------------------------------------------------------
#define WORLD10_CACHE_MAGIC 0x30444A49u
#define WORLD10_CACHE_VERSION 10u
#define WORLD10_MAX_JSON (96ll*1024ll*1024ll)

#define BLD10_GENERIC 0
#define BLD10_HOUSE 1
#define BLD10_APARTMENT 2
#define BLD10_COMMERCIAL 3
#define BLD10_INDUSTRIAL 4
#define BLD10_CIVIC 5

static int file_read_all(const char* path,char** out,DWORD* size){HANDLE f=CreateFileA(path,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;LARGE_INTEGER s;if(!GetFileSizeEx(f,&s)||s.QuadPart<=0||s.QuadPart>WORLD10_MAX_JSON){CloseHandle(f);return 0;}char*b=(char*)VirtualAlloc(NULL,(SIZE_T)s.QuadPart+1,MEM_COMMIT|MEM_RESERVE,4);if(!b){CloseHandle(f);return 0;}DWORD got=0;if(!ReadFile(f,b,(DWORD)s.QuadPart,&got,NULL)){VirtualFree(b,0,MEM_RELEASE);CloseHandle(f);return 0;}b[got]=0;CloseHandle(f);*out=b;*size=got;return 1;}

static int world_cache_write(void){HANDLE f=CreateFileA(g_cache_bin_path,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;WorldCacheHeader h={WORLD10_CACHE_MAGIC,WORLD10_CACHE_VERSION,(u32)sizeof(World),0};DWORD a=0,b=0;BOOL ok=WriteFile(f,&h,sizeof(h),&a,NULL)&&WriteFile(f,&g_world,sizeof(World),&b,NULL);CloseHandle(f);return ok&&a==sizeof(h)&&b==sizeof(World);}
static int world_cache_read(void){HANDLE f=CreateFileA(g_cache_bin_path,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;WorldCacheHeader h;DWORD a=0,b=0;BOOL ok=ReadFile(f,&h,sizeof(h),&a,NULL);if(!ok||a!=sizeof(h)||h.magic!=WORLD10_CACHE_MAGIC||h.version!=WORLD10_CACHE_VERSION||h.bytes!=(u32)sizeof(World)){CloseHandle(f);return 0;}ok=ReadFile(f,&g_world,sizeof(World),&b,NULL);CloseHandle(f);return ok&&b==sizeof(World)&&g_world.roadCount>=0&&g_world.roadCount<=MAX_ROAD_WAYS&&g_world.segCount>=0&&g_world.segCount<=MAX_SEGMENTS&&g_world.buildingCount>=0&&g_world.buildingCount<=MAX_BUILDINGS&&g_world.signalCount>=0&&g_world.signalCount<=MAX_SIGNALS&&g_world.nodeCount>=0&&g_world.nodeCount<=MAX_NODES&&g_world.edgeCount>=0&&g_world.edgeCount<=MAX_EDGES;}

static int urban10_building_class_value(const char*v){if(!v||!v[0])return BLD10_GENERIC;if(str_eq(v,"house")||str_eq(v,"residential")||str_eq(v,"detached")||str_eq(v,"semidetached_house")||str_eq(v,"terrace")||str_eq(v,"bungalow"))return BLD10_HOUSE;if(str_eq(v,"apartments")||str_eq(v,"dormitory"))return BLD10_APARTMENT;if(str_eq(v,"commercial")||str_eq(v,"retail")||str_eq(v,"office")||str_eq(v,"hotel"))return BLD10_COMMERCIAL;if(str_eq(v,"industrial")||str_eq(v,"warehouse")||str_eq(v,"hangar")||str_eq(v,"shed"))return BLD10_INDUSTRIAL;if(str_eq(v,"church")||str_eq(v,"cathedral")||str_eq(v,"civic")||str_eq(v,"school")||str_eq(v,"hospital")||str_eq(v,"public"))return BLD10_CIVIC;return BLD10_GENERIC;}
static int urban10_building_class(const Building*b){return b?(int)((b->seed>>28)&15u):0;}
static u32 urban10_building_seed(int cls){return (rng_u32()&0x0fffffffu)|(((u32)cls&15u)<<28);}

static void parse_way(const char* obj,const char* end){char highway[24]={0},building[32]={0};int isRoad=key_string(obj,end,"highway",highway,24);int isBuilding=key_string(obj,end,"building",building,32);if(!isRoad&&!isBuilding)return;static V3 pts[2048];int n=parse_geometry_points(obj,end,pts,2048);if(n<2)return;
  if(isRoad&&!road_ignored(highway)&&g_world.roadCount<MAX_ROAD_WAYS){int rid=g_world.roadCount++;RoadWay*r=&g_world.roads[rid];memset(r,0,sizeof(*r));key_string(obj,end,"name",r->name,64);str_copy(r->type,highway,24);char lanesS[16]={0},onewayS[16]={0},maxspeed[16]={0};key_string(obj,end,"lanes",lanesS,16);key_string(obj,end,"oneway",onewayS,16);key_string(obj,end,"maxspeed",maxspeed,16);int lanes=lanesS[0]?atoi(lanesS):0;int dir=0;if(str_eq(onewayS,"yes")||str_eq(onewayS,"1")||str_eq(onewayS,"true"))dir=1;else if(str_eq(onewayS,"-1")||str_eq(onewayS,"reverse"))dir=-1;r->oneway=dir;r->width=road_width(highway,lanes);r->speed=road_speed(highway,maxspeed);for(int i=1;i<n;i++){V3 a=pts[i-1],b=pts[i];add_road_segment(a,b,rid);int na=find_or_add_node(a),nb=find_or_add_node(b);if(dir>=0)add_edge(na,nb,rid);if(dir<=0)add_edge(nb,na,rid);}}
  if(isBuilding&&g_world.buildingCount<MAX_BUILDINGS&&n>=3){float minx=pts[0].x,maxx=pts[0].x,minz=pts[0].z,maxz=pts[0].z;for(int i=1;i<n;i++){minx=minf(minx,pts[i].x);maxx=maxf(maxx,pts[i].x);minz=minf(minz,pts[i].z);maxz=maxf(maxz,pts[i].z);}float sx=maxx-minx,sz=maxz-minz;if(sx<1.5f||sz<1.5f||sx>220||sz>220)return;char hs[24]={0},ls[20]={0};key_string(obj,end,"height",hs,24);key_string(obj,end,"building:levels",ls,20);int cls=urban10_building_class_value(building);float h=hs[0]?(float)atof(hs):0;if(h<=0&&ls[0])h=(float)atof(ls)*3.05f;if(h<=0){float q=rng01();if(cls==BLD10_HOUSE)h=4.8f+q*4.0f;else if(cls==BLD10_APARTMENT)h=16.0f+q*34.0f;else if(cls==BLD10_COMMERCIAL)h=7.0f+q*18.0f;else if(cls==BLD10_INDUSTRIAL)h=6.0f+q*8.0f;else if(cls==BLD10_CIVIC)h=9.0f+q*22.0f;else h=5.0f+q*18.0f;}Building*b=&g_world.buildings[g_world.buildingCount++];b->c=v3((minx+maxx)*.5f,h*.5f,(minz+maxz)*.5f);b->sx=sx;b->sz=sz;b->h=clampf(h,3,125);b->seed=urban10_building_seed(cls);}
}

static int parse_osm(char* json,DWORD size){memset(&g_world,0,sizeof(g_world));rng_state=0x91e10da5u;for(int i=0;i<NODE_HASH_SIZE;i++)g_node_hash[i]=-1;for(int i=0;i<MAX_NODES;i++){g_world.nodes[i].head=-1;g_world.nodes[i].headIn=-1;}const char*begin=json;const char*end=json+size;const char*el=find_range(begin,end,"\"elements\"");if(!el)return 0;const char*p=find_range(el,end,"[");if(!p)return 0;p++;int inString=0,esc=0,depth=0;char*objStart=NULL;for(char*c=(char*)p;c<(char*)end;c++){char ch=*c;if(inString){if(esc)esc=0;else if(ch=='\\')esc=1;else if(ch=='\"')inString=0;continue;}else if(ch=='\"'){inString=1;continue;}if(ch=='{'){if(depth==0)objStart=c;depth++;}else if(ch=='}'){depth--;if(depth==0&&objStart){char save=c[1];c[1]=0;char typ[12]={0};if(key_string(objStart,c+1,"type",typ,12)){if(str_eq(typ,"way"))parse_way(objStart,c+1);else if(str_eq(typ,"node"))parse_node(objStart,c+1);}c[1]=save;objStart=NULL;}}else if(ch==']'&&depth==0)break;}g_world.mapFromOSM=(g_world.segCount>100&&g_world.buildingCount>100);return g_world.mapFromOSM;}

static int fetch_host(LPCWSTR host,char**out,DWORD*outSize){const char*query="[out:json][timeout:60];(way[highway](-26.9580,-48.6860,-26.8840,-48.6250);node[highway=traffic_signals](-26.9580,-48.6860,-26.8840,-48.6250);way[building](-26.9580,-48.6860,-26.8840,-48.6250););out geom;";char*enc=g_post_body;int encLen=percent_encode(query,enc+5,8187);enc[0]='d';enc[1]='a';enc[2]='t';enc[3]='a';enc[4]='=';encLen+=5;HINTERNET ses=WinHttpOpen(L"ItajaiDriveNative/0.10.0",WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,NULL,NULL,0);if(!ses)return 0;WinHttpSetTimeouts(ses,7000,12000,25000,70000);HINTERNET con=WinHttpConnect(ses,host,INTERNET_DEFAULT_HTTPS_PORT,0);if(!con){WinHttpCloseHandle(ses);return 0;}HINTERNET req=WinHttpOpenRequest(con,L"POST",L"/api/interpreter",NULL,NULL,NULL,WINHTTP_FLAG_SECURE);if(!req){WinHttpCloseHandle(con);WinHttpCloseHandle(ses);return 0;}BOOL ok=WinHttpSendRequest(req,L"Content-Type: application/x-www-form-urlencoded\r\n",(DWORD)-1,enc,(DWORD)encLen,(DWORD)encLen,0)&&WinHttpReceiveResponse(req,NULL);if(!ok){WinHttpCloseHandle(req);WinHttpCloseHandle(con);WinHttpCloseHandle(ses);return 0;}DWORD cap=96u*1024u*1024u,used=0;char*data=(char*)VirtualAlloc(NULL,(SIZE_T)cap+1,MEM_COMMIT|MEM_RESERVE,4);if(!data){WinHttpCloseHandle(req);WinHttpCloseHandle(con);WinHttpCloseHandle(ses);return 0;}while(1){DWORD avail=0;if(!WinHttpQueryDataAvailable(req,&avail))break;if(!avail){ok=1;break;}if(used+avail>cap){ok=0;break;}DWORD got=0;if(!WinHttpReadData(req,data+used,avail,&got)){ok=0;break;}used+=got;if(!got)break;}data[used]=0;WinHttpCloseHandle(req);WinHttpCloseHandle(con);WinHttpCloseHandle(ses);if(!ok||used<100){VirtualFree(data,0,MEM_RELEASE);return 0;}*out=data;*outSize=used;return 1;}

static DWORD WINAPI map_worker(LPVOID unused){(void)unused;char*data=NULL;DWORD size=0;g_load_stage=0;if(world_cache_read()){g_load_stage=4;g_world_state=g_world.mapFromOSM?1:2;return 0;}if(file_read_all(g_cache_path,&data,&size)){g_load_stage=2;if(parse_osm(data,size)){g_load_stage=3;compute_components();bind_signals();world_cache_write();VirtualFree(data,0,MEM_RELEASE);g_load_stage=4;g_world_state=1;return 0;}VirtualFree(data,0,MEM_RELEASE);}g_load_stage=1;if(fetch_host(L"overpass-api.de",&data,&size)||fetch_host(L"overpass.kumi.systems",&data,&size)){file_write_all(g_cache_path,data,size);g_load_stage=2;if(parse_osm(data,size)){g_load_stage=3;compute_components();bind_signals();world_cache_write();VirtualFree(data,0,MEM_RELEASE);g_load_stage=4;g_world_state=1;return 0;}VirtualFree(data,0,MEM_RELEASE);}g_load_stage=5;build_fallback_world();world_cache_write();g_world_state=2;return 0;}

static int urban10_random_near_node(V3 p,float radius){int comp=-1,b=nearest_node(p);if(b>=0)comp=g_world.nodes[b].component;float rr=radius*radius;for(int k=0;k<600;k++){if(g_world.nodeCount<=0)break;int n=(int)(rng01()*g_world.nodeCount);if(n>=g_world.nodeCount)n=g_world.nodeCount-1;Node*x=&g_world.nodes[n];if(x->outCount<=0||(comp>=0&&x->component!=comp))continue;float dx=x->p.x-p.x,dz=x->p.z-p.z;if(dx*dx+dz*dz<=rr)return n;}return b;}
static void traffic_spawn(void){g_traffic_count=0;if(g_world.nodeCount<2)return;V3 center=v3(0,0,0);for(int i=0;i<MAX_TRAFFIC;i++){int s=urban10_random_near_node(center,1100.0f);if(s<0)break;Traffic*t=&g_traffic[g_traffic_count];memset(t,0,sizeof(*t));traffic_new_route(t,s);if(t->active){t->speed=4.5f+rng01()*7.0f;t->p=g_world.nodes[s].p;g_traffic_count++;}}}
