// 0.19 persistent in-game world editor + curated landmarks.
// F10 editor, 1-8 asset type, Enter place, Delete nearest, [ ] rotate.
// -----------------------------------------------------------------------------
#define MAX_LANDMARKS19 768
typedef struct { int type; V3 p; float yaw,scale; u32 flags; } Landmark19;
typedef struct { char magic[8]; u32 version,count; } LandmarkHeader19;
static Landmark19 g_landmarks19[MAX_LANDMARKS19];static int g_landmark_count19=0;
static int g_editor19=0,g_editor_type19=0,g_editor19_initialized=0;static float g_editor_yaw19=0,g_editor_scale19=1.0f;static char g_landmark_path19[520];
static const char*g_landmark_asset_names19[8]={"urban_tree","street_lamp","port_container","coastal_palm","urban_bench","bus_shelter","road_guardrail","road_sign"};

static void editor19_save(void){HANDLE f=CreateFileA(g_landmark_path19,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return;LandmarkHeader19 h;memset(&h,0,sizeof(h));memcpy(h.magic,"IDLMK19",7);h.version=1;h.count=(u32)g_landmark_count19;DWORD a=0,b=0;WriteFile(f,&h,sizeof(h),&a,NULL);if(g_landmark_count19)WriteFile(f,g_landmarks19,(DWORD)(g_landmark_count19*sizeof(Landmark19)),&b,NULL);CloseHandle(f);}
static void editor19_seed(void){g_landmark_count19=0;for(int i=0;i<14&&g_landmark_count19<MAX_LANDMARKS19;i++){Landmark19*l=&g_landmarks19[g_landmark_count19++];l->type=2;l->p=v3(-1730.0f+(i%7)*17.0f,.02f,-1450.0f+(i/7)*16.0f);l->yaw=(i&1)?1.5708f:0;l->scale=1.0f;l->flags=1;}for(int i=0;i<10;i++){Landmark19*l=&g_landmarks19[g_landmark_count19++];l->type=(i&1)?4:3;l->p=v3(80.0f+i*24.0f,.02f,970.0f+(i&1)*8.0f);l->yaw=0;l->scale=1.0f;l->flags=1;}for(int i=0;i<7;i++){Landmark19*l=&g_landmarks19[g_landmark_count19++];l->type=8;l->p=v3(-1630.0f+i*72.0f,.02f,-1550.0f);l->yaw=0;l->scale=1.0f;l->flags=1;}Landmark19*b=&g_landmarks19[g_landmark_count19++];b->type=9;b->p=v3(1385,.02f,-980);b->yaw=0;b->scale=1.25f;b->flags=1;editor19_save();}
static void editor19_init(void){if(g_editor19_initialized)return;g_editor19_initialized=1;sprintf(g_landmark_path19,"%s\\itajai_landmarks_v19.bin",g_exe_dir);HANDLE f=CreateFileA(g_landmark_path19,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE){editor19_seed();return;}LandmarkHeader19 h;DWORD a=0,b=0;BOOL ok=ReadFile(f,&h,sizeof(h),&a,NULL);if(!ok||a!=sizeof(h)||h.version!=1||h.count>MAX_LANDMARKS19||h.magic[0]!='I'||h.magic[1]!='D'||h.magic[2]!='L'){CloseHandle(f);editor19_seed();return;}g_landmark_count19=(int)h.count;if(g_landmark_count19&&!ReadFile(f,g_landmarks19,(DWORD)(g_landmark_count19*sizeof(Landmark19)),&b,NULL)){g_landmark_count19=0;}CloseHandle(f);}
static float editor19_radius(const Landmark19*l){if(l->type<8){int id=asset08_find(g_landmark_asset_names19[l->type]);if(id>=0)return g_assets08[id].colliderRadius*l->scale;}return l->type==8?2.0f*l->scale:.8f*l->scale;}
static void editor19_add(void){if(g_landmark_count19>=MAX_LANDMARKS19)return;V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw));Landmark19*l=&g_landmarks19[g_landmark_count19++];l->type=g_editor_type19;l->p=vadd(g_player.body.p,vmul(f,7.0f));l->p.y=.02f;l->yaw=g_editor_yaw19;l->scale=g_editor_scale19;l->flags=0;editor19_save();}
static void editor19_delete_nearest(void){float best=12.0f*12.0f;int bi=-1;for(int i=0;i<g_landmark_count19;i++){float dx=g_landmarks19[i].p.x-g_player.body.p.x,dz=g_landmarks19[i].p.z-g_player.body.p.z,d=dx*dx+dz*dz;if(d<best){best=d;bi=i;}}if(bi>=0){g_landmarks19[bi]=g_landmarks19[--g_landmark_count19];editor19_save();}}
static int editor19_resolve(void){int hits=0;for(int i=0;i<g_landmark_count19;i++){Landmark19*l=&g_landmarks19[i];float rr=editor19_radius(l);if(rr<.2f)continue;float dx=g_player.body.p.x-l->p.x,dz=g_player.body.p.z-l->p.z,minD=g_player.body.radius+rr,ds=dx*dx+dz*dz;if(ds>=minD*minD)continue;float d=(float)sqrt((double)maxf(ds,.0001f));V3 n=d>.01f?v3(dx/d,0,dz/d):v3(1,0,0);g_player.body.p=vadd(g_player.body.p,vmul(n,minD-d+.01f));g_player.speed*=.62f;hits++;}return hits;}
static void editor19_update(float dt){(void)dt;if(!g_editor19_initialized)editor19_init();if(key_tap(0x79)){g_editor19=!g_editor19;if(g_editor19&&g_camera_captured)camera_release_mouse();}if(!g_editor19){editor19_resolve();return;}g_player.speed=0;g_player.body.vel=v3(0,0,0);for(int k=0;k<8;k++)if(key_tap('1'+k))g_editor_type19=k;if(key_tap(0xDB))g_editor_yaw19-=.174533f;if(key_tap(0xDD))g_editor_yaw19+=.174533f;if(key_tap(0xBB))g_editor_scale19=clampf(g_editor_scale19+.1f,.4f,3.0f);if(key_tap(0xBD))g_editor_scale19=clampf(g_editor_scale19-.1f,.4f,3.0f);if(key_tap(0x0D))editor19_add();if(key_tap(0x2E))editor19_delete_nearest();}
static void editor19_draw(void){for(int i=0;i<g_landmark_count19;i++){Landmark19*l=&g_landmarks19[i];float dx=l->p.x-g_player.body.p.x,dz=l->p.z-g_player.body.p.z;if(dx*dx+dz*dz>620*620)continue;if(l->type<8){int id=asset08_find(g_landmark_asset_names19[l->type]);if(id>=0){float c[8][3]={{.20f,.50f,.18f},{.30f,.32f,.34f},{.65f,.20f,.10f},{.25f,.60f,.22f},{.36f,.30f,.24f},{.28f,.35f,.38f},{.38f,.40f,.42f},{.72f,.20f,.16f}};asset08_draw_instance(id,l->p,l->yaw,l->scale,c[l->type][0],c[l->type][1],c[l->type][2]);}}else if(l->type==8){draw_box(vadd(l->p,v3(0,8*l->scale,0)),1.2f*l->scale,16*l->scale,1.2f*l->scale,l->yaw,.82f,.64f,.18f);draw_box(vadd(l->p,v3(6*l->scale,15*l->scale,0)),12*l->scale,.7f*l->scale,.7f*l->scale,l->yaw,.82f,.64f,.18f);}else{draw_box(vadd(l->p,v3(0,3*l->scale,0)),1.1f*l->scale,6*l->scale,1.1f*l->scale,0,.84f,.84f,.74f);draw_box(vadd(l->p,v3(0,6.4f*l->scale,0)),1.8f*l->scale,1.0f*l->scale,1.8f*l->scale,0,.85f,.18f,.12f);}}
