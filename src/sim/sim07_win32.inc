static void draw_loading(void){glMatrixMode(GL_PROJECTION);glLoadIdentity();glOrtho(0,g_w,g_h,0,-1,1);glMatrixMode(GL_MODELVIEW);glLoadIdentity();glDisable(GL_DEPTH_TEST);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);hud_panel(g_w*.5f-310,g_h*.5f-115,620,230);gl_text(g_w*.5f-260,g_h*.5f-48,"ITAJAI DRIVE // NATIVE ENGINE 0.7",1,1,1);const char* st="PREPARANDO MAPA...";if(g_load_stage==0)st="PROCURANDO MAPA EM CACHE LOCAL...";else if(g_load_stage==1)st="BAIXANDO RUAS + PREDIOS DE ITAJAI...";else if(g_load_stage==2)st="CONSTRUINDO A CIDADE...";else if(g_load_stage==3)st="MONTANDO GRAFO DE TRANSITO...";else if(g_load_stage==5)st="SEM REDE: GERANDO CIDADE OFFLINE...";else if(g_load_stage==6)st="MONTANDO COLLIDERS + WORKING SET ESPACIAL...";gl_text(g_w*.5f-260,g_h*.5f-5,st,.55f,.82f,1);gl_text(g_w*.5f-260,g_h*.5f+35,"Cache de mundo v05 continua compativel.",.72f,.76f,.8f);gl_text(g_w*.5f-260,g_h*.5f+61,"0.7 adiciona camera livre, connectors, reroute e streaming layer.",.72f,.76f,.8f);glDisable(GL_BLEND);}
static void render(float fps){g_draw_calls=0;float sun=(g_hour>=6&&g_hour<=18)?1.0f:.22f;float cloud=g_weather==0?1:g_weather==1?.72f:.52f;glClearColor(.08f*sun*cloud,.16f*sun*cloud,.24f*sun*cloud,1);glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT);if(!g_started){draw_loading();SwapBuffers(g_hdc);return;}glEnable(GL_DEPTH_TEST);setup_camera();draw_ground();draw_roads();draw_gps();draw_buildings();draw_signals();draw_traffic();if(g_debug)foundation_draw_debug(g_player.body.p);draw_player_vehicle();draw_hud(fps);SwapBuffers(g_hdc);}

static LRESULT CALLBACK wndproc(HWND h,UINT m,WPARAM w,LPARAM l){(void)w;
  if(m==0x0201){if(g_started)camera_capture_mouse(h);return 0;} // WM_LBUTTONDOWN
  if(m==0x0200){if(g_camera_captured){camera_mouse_move(h,l);return 0;}} // WM_MOUSEMOVE
  if(m==0x0008){if(g_camera_captured)camera_release_mouse();return 0;} // WM_KILLFOCUS
  if(m==0x0215){if(g_camera_captured&&(HWND)l!=h){g_camera_captured=0;ShowCursor(TRUE);}return 0;} // WM_CAPTURECHANGED
  if(m==WM_CLOSE){if(g_camera_captured)camera_release_mouse();PostQuitMessage(0);return 0;}
  if(m==WM_DESTROY){if(g_camera_captured)camera_release_mouse();PostQuitMessage(0);return 0;}
  if(m==WM_SIZE){RECT r;GetClientRect(h,&r);g_w=r.right-r.left;g_h=r.bottom-r.top;if(g_h<1)g_h=1;glViewport(0,0,g_w,g_h);if(g_camera_captured)camera_recenter(h);return 0;}
  return DefWindowProcA(h,m,w,l);
}
static int init_window(void){HINSTANCE inst=GetModuleHandleA(NULL);WNDCLASSA wc;memset(&wc,0,sizeof(wc));wc.style=CS_OWNDC;wc.lpfnWndProc=wndproc;wc.hInstance=inst;wc.lpszClassName="ItajaiDriveNativeWindow";if(!RegisterClassA(&wc))return 0;g_hwnd=CreateWindowExA(0,wc.lpszClassName,"Itajai Drive - Native Engine 0.7.0",WS_OVERLAPPEDWINDOW|WS_VISIBLE,100,80,1280,720,NULL,NULL,inst,NULL);if(!g_hwnd)return 0;g_hdc=GetDC(g_hwnd);PIXELFORMATDESCRIPTOR pfd;memset(&pfd,0,sizeof(pfd));pfd.nSize=sizeof(pfd);pfd.nVersion=1;pfd.dwFlags=PFD_DRAW_TO_WINDOW|PFD_SUPPORT_OPENGL|PFD_DOUBLEBUFFER;pfd.iPixelType=PFD_TYPE_RGBA;pfd.cColorBits=32;pfd.cDepthBits=24;pfd.iLayerType=PFD_MAIN_PLANE;int pf=ChoosePixelFormat(g_hdc,&pfd);if(!pf||!SetPixelFormat(g_hdc,pf,&pfd))return 0;g_glrc=wglCreateContext(g_hdc);if(!g_glrc||!wglMakeCurrent(g_hdc,g_glrc))return 0;RECT r;GetClientRect(g_hwnd,&r);g_w=r.right;g_h=r.bottom;glViewport(0,0,g_w,g_h);glEnable(GL_DEPTH_TEST);glDepthFunc(GL_LEQUAL);HGDIOBJ font=GetStockObject(SYSTEM_FONT);SelectObject(g_hdc,font);g_font_base=glGenLists(96);wglUseFontBitmapsA(g_hdc,32,96,g_font_base);ShowWindow(g_hwnd,SW_SHOW);UpdateWindow(g_hwnd);return 1;}
void WinMainCRTStartup(void){init_paths();if(!init_window())ExitProcess(1);HANDLE th=CreateThread(NULL,0,map_worker,NULL,0,NULL);if(th)CloseHandle(th);LARGE_INTEGER freq,last,now;QueryPerformanceFrequency(&freq);QueryPerformanceCounter(&last);double accum=0;int frames=0;float fps=60;int running=1;while(running){MSG msg;while(PeekMessageA(&msg,NULL,0,0,PM_REMOVE)){if(msg.message==WM_QUIT){running=0;break;}TranslateMessage(&msg);DispatchMessageA(&msg);}if(!running)break;QueryPerformanceCounter(&now);double dt=(double)(now.QuadPart-last.QuadPart)/(double)freq.QuadPart;last=now;if(dt>.08)dt=.08;accum+=dt;frames++;if(accum>=.5){fps=(float)(frames/accum);frames=0;accum=0;}if(!g_started&&g_world_state!=0){g_load_stage=6;foundation_build_static();player_reset();traffic_spawn();sim07_stream_update(g_player.body.p,1.0f);g_started=1;g_load_stage=4;}game_update((float)dt);render(fps);}if(g_camera_captured)camera_release_mouse();if(g_glrc){wglMakeCurrent(NULL,NULL);wglDeleteContext(g_glrc);}if(g_hdc)ReleaseDC(g_hwnd,g_hdc);ExitProcess(0);}
