static void setup_camera(void){float aspect=(float)g_w/maxf(1,(float)g_h);glMatrixMode(GL_PROJECTION);glLoadIdentity();double near=.15,top=near*.57735,right=top*aspect;glFrustum(-right,right,-top,top,near,2200);glMatrixMode(GL_MODELVIEW);glLoadIdentity();V3 eye,target;sim07_camera_pose(g_player.camera,g_player.body.p,g_player.body.yaw,&eye,&target);V3 fw=vnorm(vsub(target,eye)),up=v3(0,1,0),s=vnorm(vcross(fw,up)),u=vcross(s,fw);float m[16]={s.x,u.x,-fw.x,0,s.y,u.y,-fw.y,0,s.z,u.z,-fw.z,0,-vdot(s,eye),-vdot(u,eye),vdot(fw,eye),1};glMultMatrixf(m);}

static void draw_lane_markings(void){
  int count=g_stream_segment_count>0?g_stream_segment_count:g_world.segCount;glLineWidth(1.25f);glBegin(GL_LINES);for(int ii=0;ii<count;ii++){int i=g_stream_segment_count>0?g_stream_segments[ii]:ii;RoadSegment*s=&g_world.segs[i];V3 mid=vmul(vadd(s->a,s->b),.5f);float px=mid.x-g_player.body.p.x,pz=mid.z-g_player.body.p.z;if(px*px+pz*pz>430*430)continue;V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<1.0f)continue;V3 right=v3(d.z/len,0,-d.x/len);RoadWay*r=&g_world.roads[s->road];float half=r->width*.5f;
    if(r->width>=8.0f){glColor3f(.78f,.80f,.79f);float eo=half-.16f;V3 la=vadd(s->a,vmul(right,eo)),lb=vadd(s->b,vmul(right,eo)),ra=vsub(s->a,vmul(right,eo)),rb=vsub(s->b,vmul(right,eo));glVertex3f(la.x,.032f,la.z);glVertex3f(lb.x,.032f,lb.z);glVertex3f(ra.x,.032f,ra.z);glVertex3f(rb.x,.032f,rb.z);}
    int total=road_total_lanes(s->road);if(!r->oneway){glColor3f(.86f,.72f,.16f);glVertex3f(s->a.x,.036f,s->a.z);glVertex3f(s->b.x,.036f,s->b.z);int per=(int)maxf(1,(float)(total/2));float lw=half/per;for(int side=-1;side<=1;side+=2)for(int k=1;k<per;k++){float off=side*(half-k*lw);glColor3f(.88f,.90f,.88f);for(float q=0;q<len;q+=8.0f){float q1=minf(q+4.0f,len),t0=q/len,t1=q1/len;V3 a=vadd(vadd(s->a,vmul(d,t0)),vmul(right,off)),b=vadd(vadd(s->a,vmul(d,t1)),vmul(right,off));glVertex3f(a.x,.038f,a.z);glVertex3f(b.x,.038f,b.z);}}}else if(total>1){float lw=r->width/total;for(int k=1;k<total;k++){float off=half-k*lw;glColor3f(.88f,.90f,.88f);for(float q=0;q<len;q+=8.0f){float q1=minf(q+4.0f,len),t0=q/len,t1=q1/len;V3 a=vadd(vadd(s->a,vmul(d,t0)),vmul(right,off)),b=vadd(vadd(s->a,vmul(d,t1)),vmul(right,off));glVertex3f(a.x,.038f,a.z);glVertex3f(b.x,.038f,b.z);}}}
  }glEnd();g_draw_calls++;}

static void draw_roads(void){int count=g_stream_segment_count>0?g_stream_segment_count:g_world.segCount;glBegin(GL_QUADS);for(int ii=0;ii<count;ii++){int i=g_stream_segment_count>0?g_stream_segments[ii]:ii;RoadSegment*s=&g_world.segs[i];V3 mid=vmul(vadd(s->a,s->b),.5f);float dx=mid.x-g_player.body.p.x,dz=mid.z-g_player.body.p.z;if(dx*dx+dz*dz>700*700)continue;V3 d=vsub(s->b,s->a);float l=vlen(d);if(l<.1f)continue;V3 r=v3(d.z/l,0,-d.x/l);float hw=g_world.roads[s->road].width*.5f;V3 a1=vadd(s->a,vmul(r,hw)),a2=vsub(s->a,vmul(r,hw)),b1=vadd(s->b,vmul(r,hw)),b2=vsub(s->b,vmul(r,hw));glColor3f(.11f,.12f,.13f);glVertex3f(a1.x,.01f,a1.z);glVertex3f(a2.x,.01f,a2.z);glVertex3f(b2.x,.01f,b2.z);glVertex3f(b1.x,.01f,b1.z);}glEnd();g_draw_calls++;draw_lane_markings();}
static void draw_buildings(void){int count=g_stream_building_count>0?g_stream_building_count:g_world.buildingCount;for(int ii=0;ii<count;ii++){int i=g_stream_building_count>0?g_stream_buildings[ii]:ii;Building*b=&g_world.buildings[i];float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z,ds=dx*dx+dz*dz;if(ds>520*520)continue;float h=(float)((b->seed>>8)&255)/255.0f;float r=.38f+h*.25f,g=.38f+h*.20f,bl=.36f+h*.18f;if(b->h>30){r=.48f;g=.50f;bl=.52f;}draw_box(b->c,b->sx,b->h,b->sz,0,r,g,bl);}}

