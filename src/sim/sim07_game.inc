// -----------------------------------------------------------------------------
// 0.7 public game loop and traffic update. The 0.6 versions remain compiled
// internally under *_legacy06 names for easy regression comparison.
// 2.2 pulls the OSM footprint sidecar forward so player physics can use an exact
// building narrow phase while preserving the spatial-grid AABB broad phase.
// -----------------------------------------------------------------------------
#include "../world/building12.inc"
#include "../foundation/collision22.inc"
static int g_gps_goal07=-1;
static float g_gps_recalc_timer07=0,g_gps_offroute07=0,g_gps_length07=0;
static int g_gps_recalc_count07=0;

static void gps_random07(void){int s=nearest_node(g_player.body.p);if(s<0)return;int comp=g_world.nodes[s].component;for(int k=0;k<20;k++){int goal=random_node_component(comp);if(goal<0)continue;int n=astar_route(s,goal,g_gps_route,MAX_ROUTE);if(n>4){g_gps_n=n;g_gps_goal07=goal;g_gps_offroute07=0;g_gps_recalc_timer07=.4f;g_gps_length07=sim07_route_length(g_gps_route,g_gps_n);return;}}g_gps_n=0;g_gps_goal07=-1;}
static void gps_update07(float dt){if(g_gps_n<=0||g_gps_goal07<0)return;g_gps_recalc_timer07-=dt;if(g_gps_recalc_timer07>0)return;g_gps_recalc_timer07=.65f;float gd=vlen(vsub(g_player.body.p,g_world.nodes[g_gps_goal07].p));if(gd<12.0f){g_gps_n=0;g_gps_goal07=-1;g_gps_offroute07=0;return;}g_gps_offroute07=sim07_distance_to_route(g_player.body.p,g_gps_route,g_gps_n);if(g_gps_offroute07>22.0f){int s=nearest_node(g_player.body.p);if(s>=0&&g_world.nodes[s].component==g_world.nodes[g_gps_goal07].component){static int tmp[MAX_ROUTE];int n=astar_route(s,g_gps_goal07,tmp,MAX_ROUTE);if(n>0){for(int i=0;i<n;i++)g_gps_route[i]=tmp[i];g_gps_n=n;g_gps_length07=sim07_route_length(g_gps_route,g_gps_n);g_gps_recalc_count07++;g_gps_offroute07=0;}}}}

static void traffic_update(float dt,double time,V3 player){
  float speedSum=0;g_sim07_turning_cars=0;
  for(int i=0;i<g_traffic_count;i++){
    Traffic*t=&g_traffic[i];if(!t->active||t->routeN<=0)continue;int eid=t->route[t->ri];if(eid<0||eid>=g_world.edgeCount)continue;Edge*e=&g_world.edges[eid];
    if(g_traffic_cruise[i]<=0){g_traffic_cruise[i]=.72f+rng01()*.25f;int lc=edge_lane_count(eid);g_traffic_lane[i]=(int)(rng01()*maxf(1,(float)lc));if(g_traffic_lane[i]>=lc)g_traffic_lane[i]=lc-1;g_traffic_prev_valid[i]=0;}
    g_traffic_lane[i]=edge_clamp_lane(eid,g_traffic_lane[i]);int lane=g_traffic_lane[i];float len=maxf(.1f,e->length);float target=minf(e->speed*g_traffic_cruise[i],16.5f);float remaining=(1.0f-t->t)*len;float stopDist=3.0f+t->speed*.85f+t->speed*t->speed/11.0f;
    if(t->ri+1<t->routeN){int ne=t->route[t->ri+1];float turnSpeed=sim07_turn_target_speed(eid,ne);if(turnSpeed<90.0f&&remaining<maxf(11.0f,t->speed*1.45f))target=minf(target,turnSpeed);}
    if(signal_red_for_node(e->to,time)&&remaining<stopDist)target=minf(target,maxf(0,(remaining-1.8f)*.65f));
    float gap=traffic_gap_ahead(i,eid,lane,t->t);g_traffic_gap[i]=gap;float safe=4.5f+t->speed*1.35f;if(gap<safe){float factor=clampf((gap-1.8f)/maxf(1.0f,safe-1.8f),0,1);target=minf(target,target*factor);}
    V3 cur;float sampleYaw;sim07_sample_traffic(i,eid,t->t,lane,&cur,&sampleYaw);V3 dir=v3((float)sin((double)sampleYaw),0,(float)cos((double)sampleYaw)),right=v3(dir.z,0,-dir.x),toPlayer=vsub(player,cur);float ahead=vdot(toPlayer,dir),side=absf(vdot(toPlayer,right));if(ahead>0&&ahead<7.5f+t->speed*.9f&&side<2.4f)target=minf(target,maxf(0,(ahead-2.4f)*.7f));
    float oldSpeed=t->speed;float accel=target>t->speed?2.35f:5.8f;t->speed=sim_move_toward(t->speed,target,accel*dt);g_traffic_brake_amount[i]=clampf((oldSpeed-t->speed)/maxf(.01f,dt*5.0f),0,1);t->t+=t->speed*dt/len;
    while(t->t>=1.0f&&t->active){int prevE=eid,prevLane=lane,toNode=e->to;t->t-=1.0f;t->ri++;if(t->ri>=t->routeN){traffic_new_route(t,toNode);if(!t->active)break;t->ri=0;}if(t->active){eid=t->route[t->ri];if(eid<0||eid>=g_world.edgeCount){t->active=0;break;}g_traffic_prev_edge[i]=prevE;g_traffic_prev_lane[i]=prevLane;g_traffic_prev_valid[i]=1;g_traffic_lane[i]=sim07_choose_next_lane(prevE,prevLane,eid);e=&g_world.edges[eid];len=maxf(.1f,e->length);lane=edge_clamp_lane(eid,g_traffic_lane[i]);}}
    if(!t->active)continue;eid=t->route[t->ri];lane=edge_clamp_lane(eid,g_traffic_lane[i]);float desiredYaw;sim07_sample_traffic(i,eid,t->t,lane,&t->p,&desiredYaw);float dy=sim07_wrap_angle(desiredYaw-t->yaw);t->yaw=sim07_wrap_angle(t->yaw+dy*clampf(dt*8.5f,0,1));if(g_traffic_prev_valid[i]&&t->t<SIM07_CONNECT_T)g_sim07_turning_cars++;speedSum+=t->speed;
  }
  g_traffic_avg_speed=g_traffic_count>0?speedSum/g_traffic_count:0;
}

static void game_update(float dt){
  g_time+=dt;update_key_edges();if(key_tap(VK_ESCAPE)){if(g_camera_captured)camera_release_mouse();else PostQuitMessage(0);}if(!g_started)return;if(!g_building12_ready)building12_prepare();camera_update(dt);if(key_tap(VK_TAB))g_debug=!g_debug;if(key_tap('T'))g_hour=(g_hour+3)%24;if(key_tap('Y'))g_weather=(g_weather+1)%4;if(key_tap('C')){g_player.camera=(g_player.camera+1)%4;camera_reset_orbit();}if(key_tap('E')){g_player.car=(g_player.car+1)%4;player_apply_profile();}if(key_tap('R'))player_reset();if(key_tap('M'))gps_random07();if(key_tap('U')){DeleteFileA(g_cache_path);DeleteFileA(g_cache_bin_path);DeleteFileA(g_cache_bin_legacy_path);}
  float throttle=key_down('W')?1.0f:0,brake=key_down('S')?1.0f:0,steerRaw=(key_down('A')?1.0f:0)-(key_down('D')?1.0f:0),steerInput=reverse211_steer_input(steerRaw);int handbrake=key_down(VK_SPACE);g_player.steer=lerpf(g_player.steer,steerInput,clampf(dt*6.5f,0,1));player_sample_wheels(dt,throttle,brake,handbrake);const VehicleProfile*vp=&g_vehicle_profiles[g_player.car];
  V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw)),right=v3(f.z,0,-f.x);float longV=vdot(g_player.body.vel,f),latV=vdot(g_player.body.vel,right);float powerMul=sim_surface_power(g_player.body.surface);float driveAccel=throttle*vp->engineAccel*powerMul;if(brake){if(longV>.45f)driveAccel-=vp->brakeAccel;else driveAccel-=5.8f*powerMul;}longV+=driveAccel*dt;float rollMul=g_player.body.surface==SURFACE_ASPHALT?1.0f:g_player.body.surface==SURFACE_CURB?1.75f:3.2f;float drag=vp->rolling*rollMul+vp->aero*longV*longV;longV=sim_move_toward(longV,0,drag*dt);if(handbrake)longV=sim_move_toward(longV,0,6.8f*dt);float surfaceMax=g_player.body.surface==SURFACE_GRASS?20.0f:g_player.body.surface==SURFACE_CURB?32.0f:vp->maxSpeed;longV=clampf(longV,-7.0f,minf(vp->maxSpeed,surfaceMax));
  g_player.body.vel=vadd(vmul(f,longV),vmul(right,latV));float steerFalloff=clampf(1.0f-absf(longV)/(vp->maxSpeed*1.8f),.48f,1.0f);float steerAngle=g_player.steer*vp->maxSteer*steerFalloff;float targetYawRate=(longV/vp->wheelbase)*steerAngle*g_player.body.grip;if(handbrake)targetYawRate*=1.10f;g_player.body.angularVel=lerpf(g_player.body.angularVel,targetYawRate,clampf(dt*(handbrake?4.0f:8.0f),0,1));g_player.body.yaw+=g_player.body.angularVel*dt;
  f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw));right=v3(f.z,0,-f.x);longV=vdot(g_player.body.vel,f);latV=vdot(g_player.body.vel,right);float lateralDamp=(handbrake?3.15f:7.4f)*g_player.body.grip/(1.0f+absf(longV)*.025f);latV*=clampf(1.0f-lateralDamp*dt,0,1);g_player.lateralSpeed=latV;g_player.slip=absf(longV)>.4f?clampf(latV/maxf(1.0f,absf(longV)),-1,1):0;g_player.body.vel=vadd(vmul(f,longV),vmul(right,latV));V3 old=g_player.body.p;g_player.body.p=vadd(g_player.body.p,vmul(g_player.body.vel,dt));g_player.body.p.y=1.0f+g_player.rideHeight;g_player.speed=longV;
  g_last_static_contacts=physics_resolve_static22(&g_player.body,&g_player.speed);if(g_last_static_contacts){f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw));g_player.speed=vdot(g_player.body.vel,f);}traffic_update(dt,g_time,g_player.body.p);g_last_dynamic_contacts=player_traffic_collisions();if(g_last_dynamic_contacts)g_last_static_contacts+=physics_resolve_static22(&g_player.body,&g_player.speed);if(dt>.00001f&&vlen(g_player.body.vel)<.001f)g_player.body.vel=vmul(vsub(g_player.body.p,old),1.0f/dt);update_nearest_road(dt);gps_update07(dt);sim07_stream_update(g_player.body.p,dt);
}
