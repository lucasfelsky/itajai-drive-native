// -----------------------------------------------------------------------------
// 0.15 per-wheel suspension/drivetrain layer over the stable simcade chassis.
// -----------------------------------------------------------------------------
typedef struct {float compression,prevCompression,velocity,normalLoad,grip,slipLong,slipLat,groundY;int surface;} WheelState15;
static WheelState15 g_wheels15[4];
static float g_engine_rpm15=850.0f,g_load_transfer15=0,g_abs15=0,g_tcs15=0;static int g_gear15=1;
static const float g_gear_ratios15[6]={0,3.55f,2.12f,1.42f,1.06f,.82f};

static void sim15_wheel_positions(V3*out){const VehicleProfile*vp=&g_vehicle_profiles[g_player.car];V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw)),r=v3(f.z,0,-f.x);float hz=vp->wheelbase*.5f,hx=vp->track*.5f;out[0]=vadd(vadd(g_player.body.p,vmul(f,hz)),vmul(r,-hx));out[1]=vadd(vadd(g_player.body.p,vmul(f,hz)),vmul(r,hx));out[2]=vadd(vadd(g_player.body.p,vmul(f,-hz)),vmul(r,-hx));out[3]=vadd(vadd(g_player.body.p,vmul(f,-hz)),vmul(r,hx));}
static void sim15_update_drivetrain(float dt){const VehicleProfile*vp=&g_vehicle_profiles[g_player.car];float speed=absf(g_player.speed),wheelRpm=speed/(6.2831853f*.31f)*60.0f,finalDrive=3.85f;float target=wheelRpm*g_gear_ratios15[g_gear15]*finalDrive;if(speed<.35f)target=850.0f+((key_down('W')?1.0f:0.0f)*1700.0f);target=clampf(target,800,6800);g_engine_rpm15=lerpf(g_engine_rpm15,target,clampf(dt*8.0f,0,1));if(g_engine_rpm15>6100&&g_gear15<5)g_gear15++;else if(g_engine_rpm15<1650&&g_gear15>1)g_gear15--;if(g_player.speed<-.5f)g_gear15=1;(void)vp;}
static void sim15_update_wheels(float dt){g_player.body.p.y=terrain11_height(g_player.body.p.x,g_player.body.p.z)+1.0f+g_player.rideHeight;V3 wp[4];sim15_wheel_positions(wp);const VehicleProfile*vp=&g_vehicle_profiles[g_player.car];float totalLoad=0,leftLoad=0,rightLoad=0,frontLoad=0,rearLoad=0,avgGrip=0;for(int i=0;i<4;i++){WheelState15*w=&g_wheels15[i];w->prevCompression=w->compression;int road=-1;float edge=0;w->surface=foundation_surface_at(wp[i],&road,&edge);float gy=terrain11_height(wp[i].x,wp[i].z)+(w->surface==SURFACE_CURB?.065f:0.0f);w->groundY=gy;float chassisBottom=g_player.body.p.y-.48f;float dist=chassisBottom-gy;float target=clampf((.58f-dist)/.34f,.04f,.96f);w->compression=lerpf(w->compression,target,clampf(dt*13.0f,0,1));w->velocity=(w->compression-w->prevCompression)/maxf(dt,.001f);float spring=26500.0f*w->compression,damp=2600.0f*w->velocity;w->normalLoad=maxf(180.0f,vp->mass*9.81f*.25f+spring*.12f+damp*.08f);w->grip=sim_surface_grip(w->surface)*vp->baseGrip;V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw)),r=v3(f.z,0,-f.x);float longV=vdot(g_player.body.vel,f),latV=vdot(g_player.body.vel,r);w->slipLat=clampf(latV/maxf(2.0f,absf(longV)),-1,1);w->slipLong=clampf((key_down('W')?1.0f:0.0f)*.18f-(key_down('S')?1.0f:0.0f)*.28f,-1,1);g_player.wheelCompression[i]=w->compression;g_player.wheelSurface[i]=w->surface;totalLoad+=w->normalLoad;avgGrip+=w->grip;if(i==0||i==2)leftLoad+=w->normalLoad;else rightLoad+=w->normalLoad;if(i<2)frontLoad+=w->normalLoad;else rearLoad+=w->normalLoad;}
  if(totalLoad>1){g_player.body.grip=clampf(avgGrip*.25f*.82f+(totalLoad/(vp->mass*9.81f))*vp->baseGrip*.18f,.32f,1.28f);float lr=(rightLoad-leftLoad)/totalLoad,fr=(frontLoad-rearLoad)/totalLoad;g_load_transfer15=absf(lr)+absf(fr);g_player.roll=lerpf(g_player.roll,clampf(lr*.23f,-.12f,.12f),clampf(dt*5.5f,0,1));g_player.pitch=lerpf(g_player.pitch,clampf(fr*.16f,-.09f,.09f),clampf(dt*5.2f,0,1));}
  float slip=0;for(int i=0;i<4;i++)slip+=absf(g_wheels15[i].slipLat);slip*=.25f;g_tcs15=(key_down('W')&&slip>.22f)?clampf((slip-.22f)*2.2f,0,.45f):0;g_abs15=(key_down('S')&&absf(g_player.speed)>8.0f)?clampf((absf(g_player.speed)-8.0f)/35.0f,0,.32f):0;if(g_tcs15>0){V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw));float lv=vdot(g_player.body.vel,f);g_player.body.vel=vsub(g_player.body.vel,vmul(f,lv*g_tcs15*dt*1.8f));}if(g_abs15>0&&key_down('S'))g_player.speed*=1.0f+g_abs15*dt*.10f;
}
static void game_update(float dt){game_update_legacy12(dt);if(!g_started||g_settings_menu_open)return;sim15_update_drivetrain(dt);sim15_update_wheels(dt);}
