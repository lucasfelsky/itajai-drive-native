static int copy_local_hashed(const char* src,const char* dst,u64 expected,const char* shaExpected){HANDLE in=CreateFileA(src,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(in==INVALID_HANDLE_VALUE)return 0;ensure_parent_dirs(dst);HANDLE out=CreateFileA(dst,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(out==INVALID_HANDLE_VALUE){CloseHandle(in);return 0;}SHA256 sh;sha_init(&sh);u8* buf=g_io_buf;u64 total=0;int ok=1;while(1){DWORD got=0;if(!ReadFile(in,buf,65536,&got,NULL)){ok=0;break;}if(!got)break;DWORD w=0;if(!WriteFile(out,buf,got,&w,NULL)||w!=got){ok=0;break;}sha_update(&sh,buf,got);total+=got;g_bytes_done+=got;update_progress();}CloseHandle(in);CloseHandle(out);u8 digest[32];char hex[65];sha_final(&sh,digest);hex32(digest,hex);if(expected&&total!=expected)ok=0;if(shaExpected&&shaExpected[0]&&!hex_eq_i(hex,shaExpected))ok=0;if(!ok)DeleteFileA(dst);return ok;}

