static void draw_ui(void){if(!g_hwnd)return;HDC dc=GetDC(g_hwnd);if(!dc)return;RECT r;GetClientRect(g_hwnd,&r);HBRUSH bg=CreateSolidBrush(rgb(17,20,26));FillRect(dc,&r,bg);DeleteObject(bg);HGDIOBJ font=GetStockObject(SYSTEM_FONT);SelectObject(dc,font);SetBkMode(dc,TRANSPARENT);SetTextColor(dc,rgb(237,241,247));const char* title="ITAJAI DRIVE // UPDATER 1.1";TextOutA(dc,28,24,title,slen(title));SetTextColor(dc,rgb(123,201,255));const char* sub="Atualizacao nativa // SHA-256 // retry // rollback seguro";TextOutA(dc,28,48,sub,slen(sub));SetTextColor(dc,rgb(235,238,243));TextOutA(dc,28,86,g_status,slen(g_status));SetTextColor(dc,rgb(158,168,182));TextOutA(dc,28,110,g_detail,slen(g_detail));RECT track={28,150,r.right-28,170};HBRUSH tb=CreateSolidBrush(rgb(46,52,63));FillRect(dc,&track,tb);DeleteObject(tb);RECT bar=track;bar.right=bar.left+(LONG)((track.right-track.left)*(g_progress/100.0));HBRUSH pb=CreateSolidBrush(rgb(64,174,255));FillRect(dc,&bar,pb);DeleteObject(pb);char v[180];sprintf(v,"Instalada: %s%s%s",g_local_version,g_remote_version[0]?"   |   Disponivel: ":"",g_remote_version[0]?g_remote_version:"");SetTextColor(dc,rgb(125,134,146));TextOutA(dc,28,188,v,slen(v));ReleaseDC(g_hwnd,dc);}

static LRESULT CALLBACK wndproc(HWND h,UINT m,WPARAM w,LPARAM l){(void)w;(void)l;if(m==WM_CLOSE||m==WM_DESTROY){PostQuitMessage(0);return 0;}return DefWindowProcA(h,m,w,l);}

static int init_window(void){HINSTANCE inst=GetModuleHandleA(NULL);WNDCLASSA wc;memset(&wc,0,sizeof(wc));wc.style=CS_OWNDC;wc.lpfnWndProc=wndproc;wc.hInstance=inst;wc.lpszClassName="ItajaiDriveUpdaterWindow";if(!RegisterClassA(&wc))return 0;g_hwnd=CreateWindowExA(0,wc.lpszClassName,"Itajai Drive Updater 1.1",WS_OVERLAPPED|WS_CAPTION|WS_SYSMENU|WS_MINIMIZEBOX|WS_VISIBLE,180,160,660,270,NULL,NULL,inst,NULL);if(!g_hwnd)return 0;ShowWindow(g_hwnd,SW_SHOW);UpdateWindow(g_hwnd);return 1;}

void WinMainCRTStartup(void){set_working_directory();if(!init_window())ExitProcess(2);DWORD tid=0;HANDLE th=CreateThread(NULL,0,updater_thread,NULL,0,&tid);MSG msg;int running=1;while(running){while(PeekMessageA(&msg,NULL,0,0,PM_REMOVE)){if(msg.message==WM_QUIT){running=0;break;}TranslateMessage(&msg);DispatchMessageA(&msg);}draw_ui();Sleep(33);}if(th)CloseHandle(th);ExitProcess(0);}