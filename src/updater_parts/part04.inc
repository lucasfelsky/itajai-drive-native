static int parse_manifest(char* text,Manifest* m){memset(m,0,sizeof(*m));char* p=text;while(*p){char* line=p;while(*p&&*p!='\n')p++;if(*p)*p++=0;line=trim(line);if(!line[0]||line[0]=='#')continue;if(starts(line,"protocol="))m->protocol=atoi(line+9);else if(starts(line,"version="))scopy(m->version,32,trim(line+8));else if(starts(line,"base_url="))scopy(m->base,1200,trim(line+9));else if(starts(line,"notes="))scopy(m->notes,192,trim(line+6));else if(starts(line,"file=")&&m->count<MAX_UPDATE_FILES){char* v=line+5;char* a=v;while(*v&&*v!='|')v++;if(!*v)continue;*v++=0;char* b=v;while(*v&&*v!='|')v++;if(!*v)continue;*v++=0;char* c=v;UpdateFile* f=&m->files[m->count];a=trim(a);b=trim(b);c=trim(c);if(!safe_relpath(a))continue;scopy(f->path,260,a);f->size=parse_u64(b);scopy(f->sha,65,c);m->count++;}}
return m->protocol==1&&m->version[0]!=0;}

static void read_version(void){char* d=0;u64 n=0;if(read_entire_file("VERSION.txt",&d,&n)){char* t=trim(d);scopy(g_local_version,32,t);VirtualFree(d,0,MEM_RELEASE);}else scopy(g_local_version,32,"0.0.0");}
static int vercmp(const char* a,const char* b){int av[3]={0,0,0},bv[3]={0,0,0};const char* p=a;for(int i=0;i<3;i++){av[i]=atoi(p);while(*p&&*p!='.')p++;if(*p=='.')p++;}p=b;for(int i=0;i<3;i++){bv[i]=atoi(p);while(*p&&*p!='.')p++;if(*p=='.')p++;}for(int i=0;i<3;i++){if(av[i]<bv[i])return-1;if(av[i]>bv[i])return 1;}return 0;}

static void read_config(char* manifestUrl,int cap){manifestUrl[0]=0;char* d=0;u64 n=0;if(!read_entire_file("update_config.ini",&d,&n))return;char* p=d;while(*p){char* line=p;while(*p&&*p!='\n')p++;if(*p)*p++=0;line=trim(line);if(!line[0]||line[0]=='#'||line[0]==';')continue;if(starts(line,"manifest_url="))scopy(manifestUrl,cap,trim(line+13));else if(starts(line,"auto_launch="))g_auto_launch=atoi(trim(line+12))?1:0;}VirtualFree(d,0,MEM_RELEASE);}

static void join_url(char* out,int cap,const char* base,const char* path){scopy(out,cap,base);int n=slen(out);if(n&&out[n-1]!='/'&&out[n-1]!='\\'){if(n<cap-1){out[n++]='/';out[n]=0;}}int i=0;while(path[i]&&(n+i)<cap-1){out[n+i]=path[i];i++;}out[n+i]=0;}

static void launch_game_after(DWORD ms){if(!g_auto_launch)return;Sleep(ms);UINT r=WinExec("ItajaiDriveNative.exe",SW_SHOW);if(r>31){Sleep(200);ExitProcess(0);}set_status("Nao consegui abrir o jogo.","Execute ItajaiDriveNative.exe manualmente.");g_state=7;}

static DWORD WINAPI updater_thread(LPVOID unused){(void)unused;set_working_directory();read_version();read_config(g_manifest_url,1400);g_state=1;g_progress=4;
if(!g_manifest_url[0]){set_status("Atualizador instalado, mas sem fonte configurada.","Abra update_config.ini para definir manifest_url. Abrindo o jogo instalado...");g_state=6;launch_game_after(1800);return 0;}
set_status("Procurando atualizacoes...","Consultando o canal configurado.");char* text=0;u64 textSize=0;if(!http_get_memory(g_manifest_url,&text,&textSize)){set_status("Nao foi possivel checar atualizacoes.","Sem problema: vou abrir a versao instalada.");g_state=6;launch_game_after(1800);return 0;}
Manifest* mp=&g_manifest;if(!parse_manifest(text,mp)){VirtualFree(text,0,MEM_RELEASE);set_status("Manifesto de atualizacao invalido.","A versao instalada continua intacta. Abrindo o jogo...");g_state=6;launch_game_after(1800);return 0;}scopy(g_remote_version,32,mp->version);int cmp=vercmp(g_local_version,mp->version);if(cmp>=0){VirtualFree(text,0,MEM_RELEASE);g_progress=100;char d[220];sprintf(d,"Instalada: %s   |   Canal: %s",g_local_version,mp->version);set_status("Voce ja esta na versao mais recente.",d);g_state=4;launch_game_after(900);return 0;}
if(mp->count<=0||!mp->base[0]){VirtualFree(text,0,MEM_RELEASE);set_status("Ha uma versao nova, mas o manifesto nao contem arquivos.","A versao instalada nao foi alterada.");g_state=7;return 0;}
CreateDirectoryA(".update",NULL);g_file_count=mp->count;g_file_index=0;g_bytes_done=0;g_bytes_total=0;for(int i=0;i<mp->count;i++)g_bytes_total+=mp->files[i].size;g_state=2;for(int i=0;i<mp->count;i++){g_file_index=i;UpdateFile* f=&mp->files[i];sprintf(f->stage,".update\\%02d.tmp",i);join_url(g_joined_url,1600,mp->base,f->path);sprintf(g_work_detail,"Arquivo %d/%d: %s",i+1,mp->count,f->path);set_status("Baixando atualizacao...",g_work_detail);if(!http_get_file_hashed(g_joined_url,f->stage,f->size,f->sha)){for(int j=0;j<=i;j++)DeleteFileA(mp->files[j].stage);VirtualFree(text,0,MEM_RELEASE);set_status("Falha ao baixar ou validar a atualizacao.","Nada foi substituido. Abrindo a versao instalada...");g_state=6;launch_game_after(2200);return 0;}g_file_index=i+1;update_progress();}
g_state=3;g_progress=96;set_status("Aplicando atualizacao...","Substituindo somente os arquivos gerenciados; caches locais serao preservados.");for(int i=0;i<mp->count;i++){UpdateFile* f=&mp->files[i];ensure_parent_dirs(f->path);if(!MoveFileExA(f->stage,f->path,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)){for(int j=i;j<mp->count;j++)DeleteFileA(mp->files[j].stage);VirtualFree(text,0,MEM_RELEASE);set_status("Nao consegui substituir um arquivo.","Feche o jogo se ele estiver aberto e execute o updater novamente.");g_state=7;return 0;}}
sprintf(g_version_text,"%s\r\n",mp->version);write_text_file("VERSION.txt",g_version_text);VirtualFree(text,0,MEM_RELEASE);g_progress=100;char done[260];if(mp->notes[0])sprintf(done,"%s",mp->notes);else sprintf(done,"Versao %s instalada com sucesso.",mp->version);set_status("Atualizacao concluida!",done);g_state=5;launch_game_after(1100);return 0;}
