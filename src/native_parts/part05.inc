// A* routing and traffic
// -----------------------------------------------------------------------------
static int astar_route(int start,int goal,int* outEdges,int maxOut){if(start<0||goal<0||start>=g_world.nodeCount||goal>=g_world.nodeCount||g_world.nodes[start].component!=g_world.nodes[goal].component)return 0;static float gScore[MAX_NODES],fScore[MAX_NODES];static int cameNode[MAX_NODES],cameEdge[MAX_NODES],heap[MAX_NODES],heapPos[MAX_NODES],closed[MAX_NODES];int N=g_world.nodeCount;for(int i=0;i<N;i++){gScore[i]=1e30f;fScore[i]=1e30f;cameNode[i]=-1;cameEdge[i]=-1;heapPos[i]=-1;closed[i]=0;}int hs=0;gScore[start]=0;V3 gd=vsub(g_world.nodes[start].p,g_world.nodes[goal].p);fScore[start]=vlen(gd);heap[hs]=start;heapPos[start]=hs++;
#define HEAP_SWAP(i,j) do{int tn=heap[i];heap[i]=heap[j];heap[j]=tn;heapPos[heap[i]]=i;heapPos[heap[j]]=j;}while(0)
  while(hs>0){int cur=heap[0];heapPos[cur]=-1;hs--;if(hs>0){heap[0]=heap[hs];heapPos[heap[0]]=0;int i=0;while(1){int l=i*2+1,r=l+1,b=i;if(l<hs&&fScore[heap[l]]<fScore[heap[b]])b=l;if(r<hs&&fScore[heap[r]]<fScore[heap[b]])b=r;if(b==i)break;HEAP_SWAP(i,b);i=b;}}if(cur==goal){static int rev[MAX_ROUTE];int rc=0,n=goal;while(n!=start&&cameEdge[n]>=0&&rc<MAX_ROUTE){rev[rc++]=cameEdge[n];n=cameNode[n];}int outN=0;for(int i=rc-1;i>=0&&outN<maxOut;i--)outEdges[outN++]=rev[i];return outN;}closed[cur]=1;for(int ei=g_world.nodes[cur].head;ei>=0;ei=g_world.edges[ei].next){Edge*e=&g_world.edges[ei];int nb=e->to;if(closed[nb])continue;float cand=gScore[cur]+e->length/maxf(4,e->speed);if(cand<gScore[nb]){cameNode[nb]=cur;cameEdge[nb]=ei;gScore[nb]=cand;float h=vlen(vsub(g_world.nodes[nb].p,g_world.nodes[goal].p))/18.0f;fScore[nb]=cand+h;int pos=heapPos[nb];if(pos<0){pos=hs;heap[hs++]=nb;heapPos[nb]=pos;}while(pos>0){int pa=(pos-1)>>1;if(fScore[heap[pa]]<=fScore[heap[pos]])break;HEAP_SWAP(pa,pos);pos=pa;}}}}
#undef HEAP_SWAP
  return 0;}
static int random_node_component(int component){for(int tries=0;tries<300;tries++){if(g_world.nodeCount<=0)return -1;int n=(int)(rng01()*g_world.nodeCount);if(n>=g_world.nodeCount)n=g_world.nodeCount-1;if(g_world.nodes[n].outCount>0&&(component<0||g_world.nodes[n].component==component))return n;}return -1;}
static int nearest_node(V3 p){float bd=1e30f;int bi=-1;for(int i=0;i<g_world.nodeCount;i++){float dx=g_world.nodes[i].p.x-p.x,dz=g_world.nodes[i].p.z-p.z,d=dx*dx+dz*dz;if(d<bd){bd=d;bi=i;}}return bi;}
static int signal_red_for_node(int node,double time){for(int i=0;i<g_world.signalCount;i++)if(g_world.signals[i].node==node){int phase=(int)(time+(node%13)*2)%36;return phase>=20;}return 0;}

typedef struct { int active,route[MAX_ROUTE],routeN,ri; float t,speed; V3 p; float yaw; } Traffic;
static Traffic g_traffic[MAX_TRAFFIC];
static int g_traffic_count=0;
static void traffic_new_route(Traffic*t,int start){int comp=(start>=0)?g_world.nodes[start].component:-1;for(int tries=0;tries<20;tries++){int goal=random_node_component(comp);if(goal<0||goal==start)continue;int n=astar_route(start,goal,t->route,MAX_ROUTE);if(n>3){t->routeN=n;t->ri=0;t->t=0;t->active=1;return;}}t->active=0;}
static void traffic_spawn(void){g_traffic_count=0;if(g_world.nodeCount<2)return;for(int i=0;i<MAX_TRAFFIC;i++){int s=random_node_component(-1);if(s<0)break;Traffic*t=&g_traffic[g_traffic_count];memset(t,0,sizeof(*t));traffic_new_route(t,s);if(t->active){t->speed=5+rng01()*5;g_traffic_count++;}}}
