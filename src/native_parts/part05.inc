static int fetch_host(LPCWSTR host,char** out,DWORD* outSize){const char* query="[out:json][timeout:28];(way[highway](-26.9160,-48.6680,-26.8980,-48.6480);node[highway=traffic_signals](-26.9160,-48.6680,-26.8980,-48.6480);way[building](-26.9160,-48.6680,-26.8980,-48.6480););out geom;";char* enc=g_post_body;int encLen=percent_encode(query,enc+5,8187);enc[0]='d';enc[1]='a';enc[2]='t';enc[3]='a';enc[4]='=';encLen+=5;
  HINTERNET ses=WinHttpOpen(L"ItajaiDriveNative/0.4.2",WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,NULL,NULL,0);if(!ses)return 0;WinHttpSetTimeouts(ses,5000,8000,12000,25000);HINTERNET con=WinHttpConnect(ses,host,INTERNET_DEFAULT_HTTPS_PORT,0);if(!con){WinHttpCloseHandle(ses);return 0;}HINTERNET req=WinHttpOpenRequest(con,L"POST",L"/api/interpreter",NULL,NULL,NULL,WINHTTP_FLAG_SECURE);if(!req){WinHttpCloseHandle(con);WinHttpCloseHandle(ses);return 0;}BOOL ok=WinHttpSendRequest(req,L"Content-Type: application/x-www-form-urlencoded\r\n",(DWORD)-1,enc,(DWORD)encLen,(DWORD)encLen,0)&&WinHttpReceiveResponse(req,NULL);if(!ok){WinHttpCloseHandle(req);WinHttpCloseHandle(con);WinHttpCloseHandle(ses);return 0;}DWORD cap=64*1024*1024,used=0;char* data=(char*)VirtualAlloc(NULL,cap+1,MEM_COMMIT|MEM_RESERVE,4);if(!data){WinHttpCloseHandle(req);WinHttpCloseHandle(con);WinHttpCloseHandle(ses);return 0;}while(1){DWORD avail=0;if(!WinHttpQueryDataAvailable(req,&avail))break;if(!avail){ok=1;break;}if(used+avail>cap){ok=0;break;}DWORD got=0;if(!WinHttpReadData(req,data+used,avail,&got)){ok=0;break;}used+=got;if(!got)break;}data[used]=0;WinHttpCloseHandle(req);WinHttpCloseHandle(con);WinHttpCloseHandle(ses);if(!ok||used<100){VirtualFree(data,0,MEM_RELEASE);return 0;}*out=data;*outSize=used;return 1;}
static DWORD WINAPI map_worker(LPVOID unused){(void)unused;char* data=NULL;DWORD size=0;g_load_stage=0;if(world_cache_read()){g_load_stage=4;g_world_state=g_world.mapFromOSM?1:2;return 0;}if(file_read_all(g_cache_path,&data,&size)){g_load_stage=2;if(parse_osm(data,size)){g_load_stage=3;compute_components();bind_signals();world_cache_write();VirtualFree(data,0,MEM_RELEASE);g_load_stage=4;g_world_state=1;return 0;}VirtualFree(data,0,MEM_RELEASE);}
