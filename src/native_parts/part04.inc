static void parse_way(const char* obj,const char* end){char highway[24]={0},building[24]={0};int isRoad=key_string(obj,end,"highway",highway,24);int isBuilding=key_string(obj,end,"building",building,24);if(!isRoad&&!isBuilding)return;
  static V3 pts[2048];int n=parse_geometry_points(obj,end,pts,2048);if(n<2)return;
  if(isRoad&&!road_ignored(highway)&&g_world.roadCount<MAX_ROAD_WAYS){int rid=g_world.roadCount++;RoadWay*r=&g_world.roads[rid];memset(r,0,sizeof(*r));key_string(obj,end,"name",r->name,64);str_copy(r->type,highway,24);char lanesS[16]={0},onewayS[16]={0},maxspeed[16]={0};key_string(obj,end,"lanes",lanesS,16);key_string(obj,end,"oneway",onewayS,16);key_string(obj,end,"maxspeed",maxspeed,16);int lanes=lanesS[0]?atoi(lanesS):0;int dir=0;if(str_eq(onewayS,"yes")||str_eq(onewayS,"1")||str_eq(onewayS,"true"))dir=1;else if(str_eq(onewayS,"-1")||str_eq(onewayS,"reverse"))dir=-1;r->oneway=dir;r->width=road_width(highway,lanes);r->speed=road_speed(highway,maxspeed);
    for(int i=1;i<n;i++){V3 a=pts[i-1],b=pts[i];add_road_segment(a,b,rid);int na=find_or_add_node(a),nb=find_or_add_node(b);if(dir>=0)add_edge(na,nb,rid);if(dir<=0)add_edge(nb,na,rid);}
  }
  if(isBuilding&&g_world.buildingCount<MAX_BUILDINGS&&n>=3){float minx=pts[0].x,maxx=pts[0].x,minz=pts[0].z,maxz=pts[0].z;for(int i=1;i<n;i++){minx=minf(minx,pts[i].x);maxx=maxf(maxx,pts[i].x);minz=minf(minz,pts[i].z);maxz=maxf(maxz,pts[i].z);}float sx=maxx-minx,sz=maxz-minz;if(sx<1.5f||sz<1.5f||sx>180||sz>180)return;char hs[20]={0},ls[20]={0};key_string(obj,end,"height",hs,20);key_string(obj,end,"building:levels",ls,20);float h=hs[0]?(float)atof(hs):0;if(h<=0&&ls[0])h=(float)atof(ls)*3.05f;if(h<=0)h=4.5f+rng01()*14.0f;Building*b=&g_world.buildings[g_world.buildingCount++];b->c=v3((minx+maxx)*.5f,h*.5f,(minz+maxz)*.5f);b->sx=sx;b->sz=sz;b->h=clampf(h,3,95);b->seed=rng_u32();}
}
static void parse_node(const char* obj,const char* end){char hw[32]={0};if(!key_string(obj,end,"highway",hw,32)||!str_eq(hw,"traffic_signals")||g_world.signalCount>=MAX_SIGNALS)return;double lat=key_number(obj,end,"lat",0),lon=key_number(obj,end,"lon",0);if(lat==0||lon==0)return;Signal*s=&g_world.signals[g_world.signalCount++];s->p=project_geo(lat,lon);s->node=-1;}
static int parse_osm(char* json,DWORD size){memset(&g_world,0,sizeof(g_world));for(int i=0;i<NODE_HASH_SIZE;i++)g_node_hash[i]=-1;for(int i=0;i<MAX_NODES;i++){g_world.nodes[i].head=-1;g_world.nodes[i].headIn=-1;}const char* begin=json;const char* end=json+size;const char* el=find_range(begin,end,"\"elements\"");if(!el)return 0;const char* p=find_range(el,end,"[");if(!p)return 0;p++;
  int inString=0,esc=0,depth=0;char* objStart=NULL;for(char* c=(char*)p;c<(char*)end;c++){char ch=*c;if(inString){if(esc)esc=0;else if(ch=='\\')esc=1;else if(ch=='\"')inString=0;continue;}else if(ch=='\"'){inString=1;continue;}if(ch=='{'){if(depth==0)objStart=c;depth++;}else if(ch=='}'){depth--;if(depth==0&&objStart){char save=c[1];c[1]=0;char typ[12]={0};if(key_string(objStart,c+1,"type",typ,12)){if(str_eq(typ,"way"))parse_way(objStart,c+1);else if(str_eq(typ,"node"))parse_node(objStart,c+1);}c[1]=save;objStart=NULL;}}else if(ch==']'&&depth==0)break;}
  g_world.mapFromOSM=(g_world.segCount>20&&g_world.buildingCount>20);return g_world.mapFromOSM;}
static void compute_components(void){int* q=(int*)VirtualAlloc(NULL,sizeof(int)*MAX_NODES,MEM_COMMIT|MEM_RESERVE,4);if(!q)return;int cid=0;for(int i=0;i<g_world.nodeCount;i++)g_world.nodes[i].component=-1;for(int root=0;root<g_world.nodeCount;root++){if(g_world.nodes[root].component>=0)continue;int h=0,t=0;q[t++]=root;g_world.nodes[root].component=cid;while(h<t){int n=q[h++];for(int ei=g_world.nodes[n].head;ei>=0;ei=g_world.edges[ei].next){int o=g_world.edges[ei].to;if(g_world.nodes[o].component<0){g_world.nodes[o].component=cid;if(t<MAX_NODES)q[t++]=o;}}for(int ei=g_world.nodes[n].headIn;ei>=0;ei=g_world.edges[ei].nextIn){int o=g_world.edges[ei].from;if(g_world.nodes[o].component<0){g_world.nodes[o].component=cid;if(t<MAX_NODES)q[t++]=o;}}}cid++;}g_world.componentCount=cid;VirtualFree(q,0,MEM_RELEASE);}
static void bind_signals(void){for(int s=0;s<g_world.signalCount;s++){float best=16*16;int bi=-1;for(int n=0;n<g_world.nodeCount;n++){float dx=g_world.nodes[n].p.x-g_world.signals[s].p.x,dz=g_world.nodes[n].p.z-g_world.signals[s].p.z,d=dx*dx+dz*dz;if(d<best){best=d;bi=n;}}g_world.signals[s].node=bi;}}

static void build_fallback_world(void){memset(&g_world,0,sizeof(g_world));for(int i=0;i<NODE_HASH_SIZE;i++)g_node_hash[i]=-1;for(int i=0;i<MAX_NODES;i++){g_world.nodes[i].head=-1;g_world.nodes[i].headIn=-1;}int rid=0;for(int gx=-4;gx<=4;gx++){RoadWay*r=&g_world.roads[rid];memset(r,0,sizeof(*r));sprintf(r->name,"Rua %d",gx+5);str_copy(r->type,"residential",24);r->width=8;r->speed=10;int road=rid++;V3 prev=v3(gx*70,0,-360);for(int z=-290;z<=360;z+=70){V3 cur=v3(gx*70,0,(float)z);add_road_segment(prev,cur,road);int a=find_or_add_node(prev),b=find_or_add_node(cur);add_edge(a,b,road);add_edge(b,a,road);prev=cur;}}
  for(int gz=-4;gz<=4;gz++){RoadWay*r=&g_world.roads[rid];memset(r,0,sizeof(*r));sprintf(r->name,"Avenida %d",gz+5);str_copy(r->type,"secondary",24);r->width=11;r->speed=13;int road=rid++;V3 prev=v3(-360,0,gz*70);for(int x=-290;x<=360;x+=70){V3 cur=v3((float)x,0,gz*70);add_road_segment(prev,cur,road);int a=find_or_add_node(prev),b=find_or_add_node(cur);add_edge(a,b,road);add_edge(b,a,road);prev=cur;}}
  g_world.roadCount=rid;for(int x=-4;x<4;x++)for(int z=-4;z<4;z++)for(int k=0;k<3;k++){if(g_world.buildingCount>=MAX_BUILDINGS)break;float cx=x*70+18+k*16,cz=z*70+18+(k&1)*22;float h=6+rng01()*35;Building*b=&g_world.buildings[g_world.buildingCount++];b->c=v3(cx,h*.5f,cz);b->sx=12+rng01()*8;b->sz=14+rng01()*10;b->h=h;b->seed=rng_u32();}g_world.mapFromOSM=0;compute_components();}

