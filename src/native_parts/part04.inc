static int percent_encode(const char* src,char* dst,int cap){static const char hex[]="0123456789ABCDEF";int o=0;for(int i=0;src[i]&&o<cap-4;i++){u8 c=(u8)src[i];int safe=(c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='-'||c=='_'||c=='.'||c=='~';if(safe)dst[o++]=(char)c;else{dst[o++]='%';dst[o++]=hex[c>>4];dst[o++]=hex[c&15];}}dst[o]=0;return o;}
