static LRESULT CALLBACK wndproc(HWND h,UINT m,WPARAM w,LPARAM l){(void)w;(void)l;if(m==WM_CLOSE){PostQuitMessage(0);return 0;}if(m==WM_DESTROY){PostQuitMessage(0);return 0;}if(m==WM_SIZE){RECT r;GetClientRect(h,&r);g_w=r.right-r.left;g_h=r.bottom-r.top;if(g_h<1)g_h=1;glViewport(0,0,g_w,g_h);return 0;}return DefWindowProcA(h,m,w,l);}
static int init_window(void){HINSTANCE inst=GetModuleHandleA(NULL);WNDCLASSA wc;memset(&wc,0,sizeof(wc));wc.style=CS_OWNDC;wc.lpfnWndProc=wndproc;wc.hInstance=inst;wc.lpszClassName="ItajaiDriveNativeWindow";if(!RegisterClassA(&wc))return 0;g_hwnd=CreateWindowExA(0,wc.lpszClassName,"Itajai Drive - Native Engine 0.4.2",WS_OVERLAPPEDWINDOW|WS_VISIBLE,100,80,1280,720,NULL,NULL,inst,NULL);if(!g_hwnd)return 0;g_hdc=GetDC(g_hwnd);PIXELFORMATDESCRIPTOR pfd;memset(&pfd,0,sizeof(pfd));pfd.nSize=sizeof(pfd);pfd.nVersion=1;pfd.dwFlags=PFD_DRAW_TO_WINDOW|PFD_SUPPORT_OPENGL|PFD_DOUBLEBUFFER;pfd.iPixelType=PFD_TYPE_RGBA;pfd.cColorBits=32;pfd.cDepthBits=24;pfd.iLayerType=PFD_MAIN_PLANE;int pf=ChoosePixelFormat(g_hdc,&pfd);if(!pf||!SetPixelFormat(g_hdc,pf,&pfd))return 0;g_glrc=wglCreateContext(g_hdc);if(!g_glrc||!wglMakeCurrent(g_hdc,g_glrc))return 0;RECT r;GetClientRect(g_hwnd,&r);g_w=r.right;g_h=r.bottom;glViewport(0,0,g_w,g_h);glEnable(GL_DEPTH_TEST);glDepthFunc(GL_LEQUAL);HGDIOBJ font=GetStockObject(SYSTEM_FONT);SelectObject(g_hdc,font);g_font_base=glGenLists(96);wglUseFontBitmapsA(g_hdc,32,96,g_font_base);ShowWindow(g_hwnd,SW_SHOW);UpdateWindow(g_hwnd);return 1;}
static void init_paths(void){char exe[520];DWORD n=GetModuleFileNameA(NULL,exe,520);exe[n]=0;int cut=(int)n-1;while(cut>=0&&exe[cut]!='\\'&&exe[cut]!='/')cut--;if(cut<0){str_copy(g_exe_dir,".",480);}else{if(cut>=479)cut=479;for(int i=0;i<cut;i++)g_exe_dir[i]=exe[i];g_exe_dir[cut]=0;}sprintf(g_cache_path,"%s\\itajai_osm_cache.json",g_exe_dir);sprintf(g_cache_bin_path,"%s\\itajai_world_v04.bin",g_exe_dir);}
void WinMainCRTStartup(void){init_paths();if(!init_window())ExitProcess(1);HANDLE th=CreateThread(NULL,0,map_worker,NULL,0,NULL);if(th)CloseHandle(th);LARGE_INTEGER freq,last,now;QueryPerformanceFrequency(&freq);QueryPerformanceCounter(&last);double accum=0;int frames=0;float fps=60;int running=1;while(running){MSG msg;while(PeekMessageA(&msg,NULL,0,0,PM_REMOVE)){if(msg.message==WM_QUIT){running=0;break;}TranslateMessage(&msg);DispatchMessageA(&msg);}if(!running)break;QueryPerformanceCounter(&now);double dt=(double)(now.QuadPart-last.QuadPart)/(double)freq.QuadPart;last=now;if(dt>.08)dt=.08;accum+=dt;frames++;if(accum>=.5){fps=(float)(frames/accum);frames=0;accum=0;}if(!g_started&&g_world_state!=0){player_reset();traffic_spawn();g_started=1;}game_update((float)dt);render(fps);}if(g_glrc){wglMakeCurrent(NULL,NULL);wglDeleteContext(g_glrc);}if(g_hdc)ReleaseDC(g_hwnd,g_hdc);ExitProcess(0);}
