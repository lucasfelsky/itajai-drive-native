static void draw_loading(void){glMatrixMode(GL_PROJECTION);glLoadIdentity();glOrtho(0,g_w,g_h,0,-1,1);glMatrixMode(GL_MODELVIEW);glLoadIdentity();glDisable(GL_DEPTH_TEST);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);hud_panel(g_w*.5f-300,g_h*.5f-110,600,220);gl_text(g_w*.5f-250,g_h*.5f-42,"ITAJAI DRIVE // NATIVE ENGINE",1,1,1);const char* st="PREPARANDO MAPA...";if(g_load_stage==0)st="PROCURANDO MAPA EM CACHE LOCAL...";else if(g_load_stage==1)st="BAIXANDO RUAS + PREDIOS DE ITAJAI...";else if(g_load_stage==2)st="CONSTRUINDO A CIDADE...";else if(g_load_stage==3)st="MONTANDO GRAFO DE TRÂNSITO...";else if(g_load_stage==5)st="SEM REDE: GERANDO CIDADE OFFLINE...";gl_text(g_w*.5f-250,g_h*.5f,st,.55f,.82f,1);gl_text(g_w*.5f-250,g_h*.5f+38,"Na primeira abertura pode demorar. Depois o mapa fica em cache.",.72f,.76f,.8f);gl_text(g_w*.5f-250,g_h*.5f+64,"As construcoes ficam prontas ANTES de liberar o carro.",.72f,.76f,.8f);glDisable(GL_BLEND);}
static void render(float fps){g_draw_calls=0;float sun=(g_hour>=6&&g_hour<=18)?1.0f:.22f;float cloud=g_weather==0?1:g_weather==1?.72f:.52f;glClearColor(.08f*sun*cloud,.16f*sun*cloud,.24f*sun*cloud,1);glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT);if(!g_started){draw_loading();SwapBuffers(g_hdc);return;}glEnable(GL_DEPTH_TEST);setup_camera();draw_ground();draw_roads();draw_gps();draw_buildings();draw_signals();draw_traffic();float carColors[4][3]={{.72f,.72f,.68f},{.18f,.50f,.82f},{.75f,.13f,.12f},{.23f,.60f,.34f}};draw_vehicle(g_player.p,g_player.yaw,carColors[g_player.car][0],carColors[g_player.car][1],carColors[g_player.car][2],1);draw_hud(fps);SwapBuffers(g_hdc);}

