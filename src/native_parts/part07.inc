static void setup_camera(void){float aspect=(float)g_w/maxf(1,(float)g_h);glMatrixMode(GL_PROJECTION);glLoadIdentity();double near=0.15,top=near*.57735,right=top*aspect;glFrustum(-right,right,-top,top,near,2200);glMatrixMode(GL_MODELVIEW);glLoadIdentity();V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw)),eye,target;if(g_player.camera==0){eye=vadd(g_player.body.p,vadd(vmul(f,-8.0f),v3(0,4.1f,0)));target=vadd(g_player.body.p,vadd(vmul(f,7),v3(0,1,0)));}else if(g_player.camera==1){eye=vadd(g_player.body.p,vadd(vmul(f,-4.4f),v3(0,2.6f,0)));target=vadd(g_player.body.p,vadd(vmul(f,8),v3(0,.8f,0)));}else if(g_player.camera==2){eye=vadd(g_player.body.p,vadd(vmul(f,1.3f),v3(0,1.35f,0)));target=vadd(eye,vmul(f,20));}else{eye=vadd(g_player.body.p,v3(0,38,0));target=g_player.body.p;target.z+=2;}
  V3 fw=vnorm(vsub(target,eye)),up=v3(0,1,0),s=vnorm(vcross(fw,up)),u=vcross(s,fw);float m[16]={s.x,u.x,-fw.x,0,s.y,u.y,-fw.y,0,s.z,u.z,-fw.z,0,-vdot(s,eye),-vdot(u,eye),vdot(fw,eye),1};glMultMatrixf(m);}
static void draw_ground(void){float r=.12f,g=.21f,b=.12f;if(g_weather>=2){r=.10f;g=.15f;b=.11f;}glColor3f(r,g,b);glBegin(GL_QUADS);glVertex3f(-1800,-.05f,-1800);glVertex3f(1800,-.05f,-1800);glVertex3f(1800,-.05f,1800);glVertex3f(-1800,-.05f,1800);glEnd();g_draw_calls++;}
static void draw_roads(void){glBegin(GL_QUADS);for(int i=0;i<g_world.segCount;i++){RoadSegment*s=&g_world.segs[i];V3 mid=vmul(vadd(s->a,s->b),.5f);float dx=mid.x-g_player.body.p.x,dz=mid.z-g_player.body.p.z;if(dx*dx+dz*dz>700*700)continue;V3 d=vsub(s->b,s->a);float l=vlen(d);if(l<.1f)continue;V3 r=v3(d.z/l,0,-d.x/l);float hw=g_world.roads[s->road].width*.5f;V3 a1=vadd(s->a,vmul(r,hw)),a2=vsub(s->a,vmul(r,hw)),b1=vadd(s->b,vmul(r,hw)),b2=vsub(s->b,vmul(r,hw));glColor3f(.11f,.12f,.13f);glVertex3f(a1.x,.01f,a1.z);glVertex3f(a2.x,.01f,a2.z);glVertex3f(b2.x,.01f,b2.z);glVertex3f(b1.x,.01f,b1.z);}glEnd();g_draw_calls++;
  glLineWidth(1.2f);glColor3f(.82f,.72f,.18f);glBegin(GL_LINES);for(int i=0;i<g_world.segCount;i++){RoadSegment*s=&g_world.segs[i];V3 mid=vmul(vadd(s->a,s->b),.5f);float dx=mid.x-g_player.body.p.x,dz=mid.z-g_player.body.p.z;if(dx*dx+dz*dz>420*420)continue;if(g_world.roads[s->road].width<8.5f)continue;glVertex3f(s->a.x,.025f,s->a.z);glVertex3f(s->b.x,.025f,s->b.z);}glEnd();g_draw_calls++;}
static void draw_buildings(void){for(int i=0;i<g_world.buildingCount;i++){Building*b=&g_world.buildings[i];float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z,ds=dx*dx+dz*dz;if(ds>520*520)continue;float h=(float)((b->seed>>8)&255)/255.0f;float r=.38f+h*.25f,g=.38f+h*.20f,bl=.36f+h*.18f;if(b->h>30){r=.48f;g=.50f;bl=.52f;}draw_box(b->c,b->sx,b->h,b->sz,0,r,g,bl);}}
static void draw_signals(void){for(int i=0;i<g_world.signalCount;i++){Signal*s=&g_world.signals[i];float dx=s->p.x-g_player.body.p.x,dz=s->p.z-g_player.body.p.z;if(dx*dx+dz*dz>180*180)continue;draw_box(vadd(s->p,v3(0,2,0)),.16f,4,.16f,0,.18f,.18f,.18f);int red=s->node>=0?signal_red_for_node(s->node,g_time):0;draw_box(vadd(s->p,v3(0,3.7f,0)),.35f,.55f,.28f,0,red?.9f:.08f,red?.08f:.75f,.05f);}}
static void draw_vehicle(V3 p,float yaw,float r,float g,float b,int player){draw_box(vadd(p,v3(0,.15f,0)),1.8f,.55f,3.9f,yaw,r,g,b);V3 f=v3((float)sin(yaw),0,(float)cos(yaw));draw_box(vadd(vadd(p,v3(0,.68f,0)),vmul(f,-.25f)),1.5f,.58f,1.95f,yaw,.10f,.15f,.20f);(void)player;}
static void draw_traffic(void){for(int i=0;i<g_traffic_count;i++){Traffic*t=&g_traffic[i];float dx=t->p.x-g_player.body.p.x,dz=t->p.z-g_player.body.p.z;if(dx*dx+dz*dz>260*260)continue;float k=(i%5)/5.0f;draw_vehicle(t->p,t->yaw,.25f+.5f*k,.28f+.25f*(1-k),.32f+.4f*((i*3)%5)/5.0f,0);}}
static void draw_gps(void){if(g_gps_n<=0)return;glLineWidth(5);glColor3f(.08f,.55f,1.0f);glBegin(GL_LINE_STRIP);int first=g_world.edges[g_gps_route[0]].from;glVertex3f(g_world.nodes[first].p.x,.12f,g_world.nodes[first].p.z);for(int i=0;i<g_gps_n;i++){Edge*e=&g_world.edges[g_gps_route[i]];glVertex3f(g_world.nodes[e->to].p.x,.12f,g_world.nodes[e->to].p.z);}glEnd();g_draw_calls++;}
static void hud_panel(float x,float y,float w,float h){glColor4f(0,0,0,.58f);glBegin(GL_QUADS);glVertex2f(x,y);glVertex2f(x+w,y);glVertex2f(x+w,y+h);glVertex2f(x,y+h);glEnd();}
static void draw_hud(float fps){glMatrixMode(GL_PROJECTION);glPushMatrix();glLoadIdentity();glOrtho(0,g_w,g_h,0,-1,1);glMatrixMode(GL_MODELVIEW);glPushMatrix();glLoadIdentity();glDisable(GL_DEPTH_TEST);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);char buf[256];hud_panel(20,20,420,158);gl_text(34,43,"ITAJAI DRIVE // NATIVE ENGINE 0.5.0",.92f,.95f,1);gl_text(34,66,g_nearest_road,1,1,1);const char* weather=g_weather==0?"LIMPO":g_weather==1?"NUBLADO":g_weather==2?"CHUVA LEVE":"CHUVA FORTE";sprintf(buf,"%02d:00  |  %s  |  %s",g_hour,weather,g_world.mapFromOSM?"OPENSTREETMAP":"FALLBACK OFFLINE");gl_text(34,88,buf,.72f,.78f,.84f);sprintf(buf,"SUPERFICIE: %s",foundation_surface_name(g_player.body.surface));gl_text(34,110,buf,.72f,.88f,.72f);gl_text(34,132,"TAB debug  T horario  Y clima  M GPS  U limpa cache",.65f,.7f,.75f);gl_text(34,152,"Mapa: (c) OpenStreetMap contributors",.45f,.5f,.56f);
  int kmh=(int)(absf(g_player.speed)*3.6f+.5f);hud_panel((float)g_w-208,(float)g_h-110,188,90);sprintf(buf,"%3d km/h",kmh);gl_text((float)g_w-185,(float)g_h-70,buf,1,1,1);sprintf(buf,"CARRO %d  CAM %d",g_player.car+1,g_player.camera+1);gl_text((float)g_w-185,(float)g_h-43,buf,.72f,.78f,.84f);
  if(g_debug){hud_panel((float)g_w-320,20,300,228);sprintf(buf,"FPS %.0f  /  calls %d",fps,g_draw_calls);gl_text((float)g_w-300,44,buf,.8f,1,.8f);sprintf(buf,"roads %d / segs %d",g_world.roadCount,g_world.segCount);gl_text((float)g_w-300,64,buf,.8f,.9f,1);sprintf(buf,"buildings %d / colliders %d",g_world.buildingCount,g_static_collider_count);gl_text((float)g_w-300,84,buf,.8f,.9f,1);sprintf(buf,"grid cells %d",g_grid_cell_count);gl_text((float)g_w-300,104,buf,.8f,.9f,1);sprintf(buf,"grid links C:%d R:%d",g_grid_collider_link_count,g_grid_road_link_count);gl_text((float)g_w-300,124,buf,.8f,.9f,1);sprintf(buf,"nearby candidates %d",g_foundation_last_candidates);gl_text((float)g_w-300,144,buf,.8f,.9f,1);sprintf(buf,"contact static:%d dynamic:%d",g_last_static_contacts,g_last_dynamic_contacts);gl_text((float)g_w-300,164,buf,.95f,.72f,.55f);sprintf(buf,"nodes %d / edges %d / comps %d",g_world.nodeCount,g_world.edgeCount,g_world.componentCount);gl_text((float)g_w-300,184,buf,.8f,.9f,1);sprintf(buf,"traffic %d  grip %.2f",g_traffic_count,g_player.body.grip);gl_text((float)g_w-300,204,buf,.8f,.9f,1);sprintf(buf,"road center %.1fm",g_foundation_last_road_distance);gl_text((float)g_w-300,224,buf,.8f,.9f,1);gl_text((float)g_w-300,244,"AZUL grid / LARANJA colliders",.55f,.82f,1);}
  glDisable(GL_BLEND);glEnable(GL_DEPTH_TEST);glPopMatrix();glMatrixMode(GL_PROJECTION);glPopMatrix();glMatrixMode(GL_MODELVIEW);}
