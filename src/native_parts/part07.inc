static void setup_camera(void){float aspect=(float)g_w/maxf(1,(float)g_h);glMatrixMode(GL_PROJECTION);glLoadIdentity();double near=0.15,top=near*.57735,right=top*aspect;glFrustum(-right,right,-top,top,near,2200);glMatrixMode(GL_MODELVIEW);glLoadIdentity();V3 f=v3((float)sin(g_player.body.yaw),0,(float)cos(g_player.body.yaw)),eye,target;if(g_player.camera==0){eye=vadd(g_player.body.p,vadd(vmul(f,-8.0f),v3(0,4.1f,0)));target=vadd(g_player.body.p,vadd(vmul(f,7),v3(0,1,0)));}else if(g_player.camera==1){eye=vadd(g_player.body.p,vadd(vmul(f,-4.4f),v3(0,2.6f,0)));target=vadd(g_player.body.p,vadd(vmul(f,8),v3(0,.8f,0)));}else if(g_player.camera==2){eye=vadd(g_player.body.p,vadd(vmul(f,1.3f),v3(0,1.35f,0)));target=vadd(eye,vmul(f,20));}else{eye=vadd(g_player.body.p,v3(0,38,0));target=g_player.body.p;target.z+=2;}V3 fw=vnorm(vsub(target,eye)),up=v3(0,1,0),s=vnorm(vcross(fw,up)),u=vcross(s,fw);float m[16]={s.x,u.x,-fw.x,0,s.y,u.y,-fw.y,0,s.z,u.z,-fw.z,0,-vdot(s,eye),-vdot(u,eye),vdot(fw,eye),1};glMultMatrixf(m);}
static void draw_ground(void){float r=.12f,g=.21f,b=.12f;if(g_weather>=2){r=.10f;g=.15f;b=.11f;}glColor3f(r,g,b);glBegin(GL_QUADS);glVertex3f(-1800,-.05f,-1800);glVertex3f(1800,-.05f,-1800);glVertex3f(1800,-.05f,1800);glVertex3f(-1800,-.05f,1800);glEnd();g_draw_calls++;}
static void draw_lane_markings(void){
  glLineWidth(1.25f);glBegin(GL_LINES);for(int i=0;i<g_world.segCount;i++){RoadSegment*s=&g_world.segs[i];V3 mid=vmul(vadd(s->a,s->b),.5f);float px=mid.x-g_player.body.p.x,pz=mid.z-g_player.body.p.z;if(px*px+pz*pz>430*430)continue;V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<1.0f)continue;V3 right=v3(d.z/len,0,-d.x/len);RoadWay*r=&g_world.roads[s->road];float half=r->width*.5f;
    if(r->width>=8.0f){glColor3f(.78f,.80f,.79f);float eo=half-.16f;V3 la=vadd(s->a,vmul(right,eo)),lb=vadd(s->b,vmul(right,eo)),ra=vsub(s->a,vmul(right,eo)),rb=vsub(s->b,vmul(right,eo));glVertex3f(la.x,.032f,la.z);glVertex3f(lb.x,.032f,lb.z);glVertex3f(ra.x,.032f,ra.z);glVertex3f(rb.x,.032f,rb.z);}
    int total=road_total_lanes(s->road);if(!r->oneway){glColor3f(.86f,.72f,.16f);glVertex3f(s->a.x,.036f,s->a.z);glVertex3f(s->b.x,.036f,s->b.z);int per=maxf(1,(float)(total/2));float lw=half/per;for(int side=-1;side<=1;side+=2)for(int k=1;k<per;k++){float off=side*(half-k*lw);glColor3f(.88f,.90f,.88f);for(float q=0;q<len;q+=8.0f){float q1=minf(q+4.0f,len),t0=q/len,t1=q1/len;V3 a=vadd(vadd(s->a,vmul(d,t0)),vmul(right,off)),b=vadd(vadd(s->a,vmul(d,t1)),vmul(right,off));glVertex3f(a.x,.038f,a.z);glVertex3f(b.x,.038f,b.z);}}}else if(total>1){float lw=r->width/total;for(int k=1;k<total;k++){float off=half-k*lw;glColor3f(.88f,.90f,.88f);for(float q=0;q<len;q+=8.0f){float q1=minf(q+4.0f,len),t0=q/len,t1=q1/len;V3 a=vadd(vadd(s->a,vmul(d,t0)),vmul(right,off)),b=vadd(vadd(s->a,vmul(d,t1)),vmul(right,off));glVertex3f(a.x,.038f,a.z);glVertex3f(b.x,.038f,b.z);}}}
  }glEnd();g_draw_calls++;}
static void draw_roads(void){glBegin(GL_QUADS);for(int i=0;i<g_world.segCount;i++){RoadSegment*s=&g_world.segs[i];V3 mid=vmul(vadd(s->a,s->b),.5f);float dx=mid.x-g_player.body.p.x,dz=mid.z-g_player.body.p.z;if(dx*dx+dz*dz>700*700)continue;V3 d=vsub(s->b,s->a);float l=vlen(d);if(l<.1f)continue;V3 r=v3(d.z/l,0,-d.x/l);float hw=g_world.roads[s->road].width*.5f;V3 a1=vadd(s->a,vmul(r,hw)),a2=vsub(s->a,vmul(r,hw)),b1=vadd(s->b,vmul(r,hw)),b2=vsub(s->b,vmul(r,hw));glColor3f(.11f,.12f,.13f);glVertex3f(a1.x,.01f,a1.z);glVertex3f(a2.x,.01f,a2.z);glVertex3f(b2.x,.01f,b2.z);glVertex3f(b1.x,.01f,b1.z);}glEnd();g_draw_calls++;draw_lane_markings();}
static void draw_buildings(void){for(int i=0;i<g_world.buildingCount;i++){Building*b=&g_world.buildings[i];float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z,ds=dx*dx+dz*dz;if(ds>520*520)continue;float h=(float)((b->seed>>8)&255)/255.0f;float r=.38f+h*.25f,g=.38f+h*.20f,bl=.36f+h*.18f;if(b->h>30){r=.48f;g=.50f;bl=.52f;}draw_box(b->c,b->sx,b->h,b->sz,0,r,g,bl);}}
static void draw_signals(void){for(int i=0;i<g_world.signalCount;i++){Signal*s=&g_world.signals[i];float dx=s->p.x-g_player.body.p.x,dz=s->p.z-g_player.body.p.z;if(dx*dx+dz*dz>180*180)continue;draw_box(vadd(s->p,v3(0,2,0)),.16f,4,.16f,0,.18f,.18f,.18f);int red=s->node>=0?signal_red_for_node(s->node,g_time):0;draw_box(vadd(s->p,v3(0,3.7f,0)),.35f,.55f,.28f,0,red?.9f:.08f,red?.08f:.75f,.05f);}}
static void draw_vehicle(V3 p,float yaw,float r,float g,float b,int player){draw_box(vadd(p,v3(0,.15f,0)),1.8f,.55f,3.9f,yaw,r,g,b);V3 f=v3((float)sin(yaw),0,(float)cos(yaw));draw_box(vadd(vadd(p,v3(0,.68f,0)),vmul(f,-.25f)),1.5f,.58f,1.95f,yaw,.10f,.15f,.20f);(void)player;}
static void draw_local_box(float x,float y,float z,float sx,float sy,float sz,float r,float g,float b){glPushMatrix();glTranslatef(x,y,z);glScalef(sx,sy,sz);glColor3f(r,g,b);draw_unit_box();glPopMatrix();}
static void draw_player_vehicle(void){
  const VehicleProfile*vp=&g_vehicle_profiles[g_player.car];float bodyW=g_player.car==3?2.02f:1.82f,bodyL=g_player.car==3?4.35f:3.95f;float cc[4][3]={{.72f,.72f,.68f},{.18f,.50f,.82f},{.75f,.13f,.12f},{.23f,.60f,.34f}};float*r=cc[g_player.car];glPushMatrix();glTranslatef(g_player.body.p.x,g_player.body.p.y,g_player.body.p.z);glRotatef(g_player.body.yaw*57.29578f,0,1,0);glRotatef(g_player.pitch*57.29578f,1,0,0);glRotatef(g_player.roll*57.29578f,0,0,1);draw_local_box(0,.15f,0,bodyW,.55f,bodyL,r[0],r[1],r[2]);draw_local_box(0,.68f,-.24f,bodyW*.82f,.58f,bodyL*.50f,.10f,.15f,.20f);
  float hx=vp->track*.5f,hz=vp->wheelbase*.5f;for(int i=0;i<4;i++){int front=i<2,rightSide=(i&1);float x=rightSide?hx:-hx,z=front?hz:-hz;float comp=g_player.wheelCompression[i];glPushMatrix();glTranslatef(x,-.50f+(comp-.5f)*.08f,z);if(front)glRotatef(g_player.steer*vp->maxSteer*57.29578f,0,1,0);glScalef(.33f,.34f,.70f);glColor3f(.045f,.045f,.05f);draw_unit_box();glPopMatrix();}glPopMatrix();}
static void draw_traffic(void){for(int i=0;i<g_traffic_count;i++){Traffic*t=&g_traffic[i];float dx=t->p.x-g_player.body.p.x,dz=t->p.z-g_player.body.p.z;if(dx*dx+dz*dz>300*300)continue;float k=(i%5)/5.0f;draw_vehicle(t->p,t->yaw,.25f+.5f*k,.28f+.25f*(1-k),.32f+.4f*((i*3)%5)/5.0f,0);if(g_traffic_brake_amount[i]>.12f){V3 f=v3((float)sin(t->yaw),0,(float)cos(t->yaw)),rt=v3(f.z,0,-f.x),rear=vadd(t->p,vmul(f,-2.02f));draw_box(vadd(vadd(rear,vmul(rt,.58f)),v3(0,.22f,0)),.20f,.16f,.12f,t->yaw,1,.04f,.03f);draw_box(vadd(vsub(rear,vmul(rt,.58f)),v3(0,.22f,0)),.20f,.16f,.12f,t->yaw,1,.04f,.03f);}}}
static void draw_gps(void){if(g_gps_n<=0)return;glLineWidth(5);glColor3f(.08f,.55f,1.0f);glBegin(GL_LINE_STRIP);int first=g_world.edges[g_gps_route[0]].from;glVertex3f(g_world.nodes[first].p.x,.12f,g_world.nodes[first].p.z);for(int i=0;i<g_gps_n;i++){Edge*e=&g_world.edges[g_gps_route[i]];glVertex3f(g_world.nodes[e->to].p.x,.12f,g_world.nodes[e->to].p.z);}glEnd();g_draw_calls++;}
static void hud_panel(float x,float y,float w,float h){glColor4f(0,0,0,.58f);glBegin(GL_QUADS);glVertex2f(x,y);glVertex2f(x+w,y);glVertex2f(x+w,y+h);glVertex2f(x,y+h);glEnd();}
static char wheel_surface_char(int s){return s==SURFACE_ASPHALT?'A':s==SURFACE_CURB?'C':'G';}
