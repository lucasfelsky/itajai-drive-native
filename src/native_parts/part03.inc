static V3 project_geo(double lat,double lon){const double DEG=111320.0, centerLat=-26.9070, centerLon=-48.6580, cosLat=0.8917;float x=(float)((lon-centerLon)*DEG*cosLat);float z=(float)(-(lat-centerLat)*DEG);return v3(x,0,z);}
static float road_width(const char* type,int lanes){float b=5.5f;if(str_eq(type,"motorway"))b=18;else if(str_eq(type,"trunk"))b=16;else if(str_eq(type,"primary"))b=13;else if(str_eq(type,"secondary"))b=11;else if(str_eq(type,"tertiary"))b=9;else if(str_eq(type,"residential"))b=7;else if(str_eq(type,"unclassified"))b=6.5f;else if(str_eq(type,"living_street"))b=5.5f;else if(str_eq(type,"service"))b=4.5f;if(lanes>0)b=maxf(b,lanes*3.1f+1);return b;}
static float road_speed(const char* type,const char* maxspeed){int k=maxspeed&&maxspeed[0]?atoi(maxspeed):0;if(k>0)return clampf(k/3.6f,4,28);if(str_eq(type,"motorway"))k=90;else if(str_eq(type,"trunk"))k=70;else if(str_eq(type,"primary"))k=55;else if(str_eq(type,"secondary"))k=50;else if(str_eq(type,"tertiary"))k=45;else if(str_eq(type,"living_street")||str_eq(type,"service"))k=20;else k=35;return k/3.6f;}
static int road_ignored(const char* t){return str_eq(t,"footway")||str_eq(t,"path")||str_eq(t,"steps")||str_eq(t,"pedestrian")||str_eq(t,"cycleway")||str_eq(t,"construction")||str_eq(t,"proposed")||str_eq(t,"raceway");}
static int quant_key(float v){return (int)(v>=0?v+.375f:v-.375f);}
static int find_or_add_node(V3 p){int qx=quant_key(p.x/.75f),qz=quant_key(p.z/.75f);u32 h=((u32)(qx*73856093)^(u32)(qz*19349663))&(NODE_HASH_SIZE-1);for(int i=g_node_hash[h];i>=0;i=g_world.nodes[i].hashNext){Node*n=&g_world.nodes[i];if(quant_key(n->p.x/.75f)==qx&&quant_key(n->p.z/.75f)==qz)return i;}if(g_world.nodeCount>=MAX_NODES)return -1;int id=g_world.nodeCount++;Node*n=&g_world.nodes[id];n->p=p;n->head=-1;n->headIn=-1;n->component=-1;n->outCount=0;n->hashNext=g_node_hash[h];g_node_hash[h]=id;return id;}
static void add_edge(int from,int to,int road){if(from<0||to<0||from==to||g_world.edgeCount>=MAX_EDGES)return;V3 d=vsub(g_world.nodes[to].p,g_world.nodes[from].p);float len=vlen(d);if(len<.35f)return;int id=g_world.edgeCount++;Edge*e=&g_world.edges[id];e->from=from;e->to=to;e->road=road;e->length=len;e->speed=g_world.roads[road].speed;e->width=g_world.roads[road].width;e->next=g_world.nodes[from].head;g_world.nodes[from].head=id;e->nextIn=g_world.nodes[to].headIn;g_world.nodes[to].headIn=id;g_world.nodes[from].outCount++;}
static void add_road_segment(V3 a,V3 b,int road){if(g_world.segCount>=MAX_SEGMENTS)return;g_world.segs[g_world.segCount].a=a;g_world.segs[g_world.segCount].b=b;g_world.segs[g_world.segCount].road=road;g_world.segCount++;}
static int parse_geometry_points(const char* obj,const char* end,V3* pts,int maxPts){const char* g=find_range(obj,end,"\"geometry\"");if(!g)return 0;const char* a=find_range(g,end,"[");if(!a)return 0;int depth=0,count=0;const char* p=a;const char* arrEnd=end;for(;p<end;p++){if(*p=='[')depth++;else if(*p==']'){depth--;if(depth==0){arrEnd=p;break;}}}
p=a;while(p<arrEnd&&count<maxPts){const char* latp=find_range(p,arrEnd,"\"lat\"");if(!latp)break;const char* lonp=find_range(latp,arrEnd,"\"lon\"");if(!lonp)break;const char* c1=find_range(latp,arrEnd,":");const char* c2=find_range(lonp,arrEnd,":");if(!c1||!c2)break;double lat=atof(c1+1),lon=atof(c2+1);pts[count++]=project_geo(lat,lon);p=c2+1;}return count;}
