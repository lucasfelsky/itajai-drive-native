static int key_string(const char* obj,const char* end,const char* key,char* out,int cap){char pat[96];sprintf(pat,"\"%s\"",key);const char* p=find_range(obj,end,pat);if(!p)return 0;p+=strlen(pat);p=find_range(p,end,":");if(!p)return 0;p=skip_ws(p+1);if(*p!='\"')return 0;p++;int i=0;while(p<end&&*p&&*p!='\"'&&i<cap-1){if(*p=='\\'&&p+1<end)p++;out[i++]=*p++;}out[i]=0;return i>0;}
static double key_number(const char* obj,const char* end,const char* key,double def){char pat[96];sprintf(pat,"\"%s\"",key);const char* p=find_range(obj,end,pat);if(!p)return def;p+=strlen(pat);p=find_range(p,end,":");if(!p)return def;p=skip_ws(p+1);return atof(p);}
static int file_read_all(const char* path,char** out,DWORD* size){HANDLE f=CreateFileA(path,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;LARGE_INTEGER s;if(!GetFileSizeEx(f,&s)||s.QuadPart<=0||s.QuadPart>64ll*1024ll*1024ll){CloseHandle(f);return 0;}char* b=(char*)VirtualAlloc(NULL,(SIZE_T)s.QuadPart+1,MEM_COMMIT|MEM_RESERVE,4);if(!b){CloseHandle(f);return 0;}DWORD got=0;if(!ReadFile(f,b,(DWORD)s.QuadPart,&got,NULL)){VirtualFree(b,0,MEM_RELEASE);CloseHandle(f);return 0;}b[got]=0;CloseHandle(f);*out=b;*size=got;return 1;}
static int file_write_all(const char* path,const char* data,DWORD size){HANDLE f=CreateFileA(path,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;DWORD wrote=0;BOOL ok=WriteFile(f,data,size,&wrote,NULL);CloseHandle(f);return ok&&wrote==size;}
typedef struct { u32 magic,version,bytes,reserved; } WorldCacheHeader;
static int world_cache_write(void){HANDLE f=CreateFileA(g_cache_bin_path,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;WorldCacheHeader h={0x35444A49u,5u,(u32)sizeof(World),0};DWORD a=0,b=0;BOOL ok=WriteFile(f,&h,sizeof(h),&a,NULL)&&WriteFile(f,&g_world,sizeof(World),&b,NULL);CloseHandle(f);return ok&&a==sizeof(h)&&b==sizeof(World);}
static int world_cache_read(void){HANDLE f=CreateFileA(g_cache_bin_path,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,NULL);if(f==INVALID_HANDLE_VALUE)return 0;WorldCacheHeader h;DWORD a=0,b=0;BOOL ok=ReadFile(f,&h,sizeof(h),&a,NULL);if(!ok||a!=sizeof(h)||h.magic!=0x35444A49u||h.version!=5u||h.bytes!=(u32)sizeof(World)){CloseHandle(f);return 0;}ok=ReadFile(f,&g_world,sizeof(World),&b,NULL);CloseHandle(f);return ok&&b==sizeof(World)&&g_world.roadCount>=0&&g_world.roadCount<=MAX_ROAD_WAYS&&g_world.segCount>=0&&g_world.segCount<=MAX_SEGMENTS&&g_world.buildingCount>=0&&g_world.buildingCount<=MAX_BUILDINGS&&g_world.signalCount>=0&&g_world.signalCount<=MAX_SIGNALS&&g_world.nodeCount>=0&&g_world.nodeCount<=MAX_NODES&&g_world.edgeCount>=0&&g_world.edgeCount<=MAX_EDGES;}

