// -----------------------------------------------------------------------------
// Renderer 5.0 terrain-hugging contact shadows. The old inexpensive projected
// city shadows remain; this near-field layer anchors cars to sloped/uneven ground
// with a small, quality-capped cost and no shadow-map allocation.
// -----------------------------------------------------------------------------
static int g_shadow500_contacts=0;
static void shadow500_quad(V3 p,float yaw,float width,float length,float alpha){V3 f=v3((float)sin((double)yaw),0,(float)cos((double)yaw)),r=v3(f.z,0,-f.x);float hw=width*.5f,hl=length*.5f;V3 q[4]={vadd(p,vadd(vmul(f,hl),vmul(r,hw))),vadd(p,vadd(vmul(f,hl),vmul(r,-hw))),vadd(p,vadd(vmul(f,-hl),vmul(r,-hw))),vadd(p,vadd(vmul(f,-hl),vmul(r,hw)))};for(int i=0;i<4;i++)q[i].y=terrain11_height(q[i].x,q[i].z)+.052f;glColor4f(0,0,0,alpha);for(int i=0;i<4;i++)glVertex3f(q[i].x,q[i].y,q[i].z);}
static void shadow500_vehicle(V3 p,float yaw,float width,float length,float strength){for(int layer=0;layer<3;layer++){float k=1.0f+layer*.18f,a=strength/(1.0f+layer*1.35f);shadow500_quad(p,yaw,width*k,length*k,a);}g_shadow500_contacts++;}
static void renderer500_draw_contact_shadows(void){g_shadow500_contacts=0;if(!g_started)return;renderer09_suspend_shader();glDisable(GL_TEXTURE_2D);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);glDepthMask(0);glBegin(GL_QUADS);const VehicleProfile*vp=&g_vehicle_profiles[g_player.car&3];shadow500_vehicle(g_player.body.p,g_player.body.yaw,maxf(1.55f,vp->track*1.18f),maxf(3.25f,vp->wheelbase*1.48f),.16f);int cap=g_perf80_quality==0?5:(g_perf80_quality==1?9:14);float maxD=g_perf80_quality==0?58.0f:(g_perf80_quality==1?78.0f:105.0f);float d2max=maxD*maxD;for(int i=0;i<g_traffic_count&&cap>0;i++){Traffic*t=&g_traffic[i];if(!t->active)continue;float dx=t->p.x-g_player.body.p.x,dz=t->p.z-g_player.body.p.z,d2=dx*dx+dz*dz;if(d2>d2max)continue;int model=(i*5+i/3)&7;const CarVisual160*v=&g_car_visual160[model];float fade=1.0f-clampf((float)sqrt((double)d2)/maxD,0,1);shadow500_vehicle(t->p,t->yaw,v->w*.92f,v->l*.86f,.105f*fade);cap--;}glEnd();glDepthMask(1);glDisable(GL_BLEND);renderer09_resume_shader();}
static void shadow500_overlay(void){if(!g_debug||g_settings_menu_open||(g_photo70&&g_photo70_hide_hud))return;settings_draw_2d_begin();char b[100];sprintf(b,"SHADOW 5.0 // contact cars %d",g_shadow500_contacts);gl_text((float)g_w-462,127,b,.60f,.67f,.72f);settings_draw_2d_end();}
