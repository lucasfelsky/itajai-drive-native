// -----------------------------------------------------------------------------
// Renderer 5.0 material texture upgrade.
// Replaces the legacy 64px seed textures with 256px procedural surfaces while
// preserving the existing material IDs/shader contract.
// -----------------------------------------------------------------------------
#define MAT500_SIZE 256
static u8 g_mat500_pixels[MAT500_SIZE*MAT500_SIZE*3];static int g_mat500_ready=0;
static u32 mat500_hash(u32 x,u32 y,u32 s){u32 h=x*0x9e3779b1u^y*0x85ebca6bu^s;h^=h>>16;h*=0x7feb352du;h^=h>>15;return h^(h>>16);}
static int mat500_clampi(int v,int a,int b){return v<a?a:v>b?b:v;}
static void mat500_fill(int kind){for(int y=0;y<MAT500_SIZE;y++)for(int x=0;x<MAT500_SIZE;x++){u32 h=mat500_hash((u32)x,(u32)y,771u+(u32)kind*991u),h2=mat500_hash((u32)(x/4),(u32)(y/4),119u+(u32)kind);int i=(y*MAT500_SIZE+x)*3;if(kind==1){int fine=(int)(h&31),clump=(int)(h2&31);int blade=((x*7+y*13+(int)(h>>8))%43)<2;g_mat500_pixels[i]=(u8)mat500_clampi(31+fine/4+clump/7+(blade?5:0),0,255);g_mat500_pixels[i+1]=(u8)mat500_clampi(70+fine+clump/3+(blade?18:0),0,255);g_mat500_pixels[i+2]=(u8)mat500_clampi(29+fine/5+clump/8,0,255);}else if(kind==2){int fine=(int)(h&27),large=(int)(h2&19);int aggregate=((h>>10)&31)<4;int crack=((x*17+y*11+(int)(h>>16))%211)==0;int oil=((x-172)*(x-172)+(y-84)*(y-84)<260&&((h>>7)&7)>2);int v=38+fine/2+large/3+(aggregate?8:0)-(crack?19:0)-(oil?5:0);g_mat500_pixels[i]=(u8)mat500_clampi(v,0,255);g_mat500_pixels[i+1]=(u8)mat500_clampi(v+1,0,255);g_mat500_pixels[i+2]=(u8)mat500_clampi(v+2,0,255);}else{int bx=x%32,by=y%28;int mortar=bx<2||by<2;int window=bx>5&&bx<26&&by>5&&by<21;int row=(y/28)&3;int base=mortar?105:window?(44+row*3):(132+(int)(h2&15));g_mat500_pixels[i]=(u8)mat500_clampi(base+(window?0:5),0,255);g_mat500_pixels[i+1]=(u8)mat500_clampi(base+(window?10:7),0,255);g_mat500_pixels[i+2]=(u8)mat500_clampi(base+(window?20:9),0,255);}}}
static void mat500_upload(u32 tex,int kind){if(!tex)return;mat500_fill(kind);glBindTexture(GL_TEXTURE_2D,tex);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_REPEAT);glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_REPEAT);glTexImage2D(GL_TEXTURE_2D,0,GL_RGB,MAT500_SIZE,MAT500_SIZE,0,GL_RGB,GL_UNSIGNED_BYTE,g_mat500_pixels);}
static void materials500_init(void){if(g_mat500_ready)return;g_mat500_ready=1;mat500_upload(g_tex_grass09,1);mat500_upload(g_tex_road09,2);mat500_upload(g_tex_build09,3);glBindTexture(GL_TEXTURE_2D,0);}
