// -----------------------------------------------------------------------------
// Renderer 5.0 urban lighting. Reconstructs the deterministic street-lamp sites
// already used by the city passes, then adds cheap HDR additive bulbs + small
// terrain-hugging pools. All lamps are emitted in one GL batch so the feature is
// cheap enough to remain enabled in the 60-fps quality target.
// -----------------------------------------------------------------------------
static int g_lighting500_lamps=0,g_lighting500_pools=0;
static void lighting500_head_emit(V3 p,float scale){float y=terrain11_height(p.x,p.z)+3.52f*scale;for(int layer=0;layer<3;layer++){float r=layer==0?.12f:layer==1?.32f:.72f,a=layer==0?.82f:layer==1?.34f:.09f;glColor4f(1.0f,.72f,.32f,a);glVertex3f(p.x-r,y-r,p.z);glVertex3f(p.x+r,y-r,p.z);glVertex3f(p.x+r,y+r,p.z);glVertex3f(p.x-r,y+r,p.z);glVertex3f(p.x,y-r,p.z-r);glVertex3f(p.x,y-r,p.z+r);glVertex3f(p.x,y+r,p.z+r);glVertex3f(p.x,y+r,p.z-r);}g_lighting500_lamps++;}
static void lighting500_pool_emit(V3 p,float radius){for(int ring=0;ring<2;ring++){float r=radius*(ring?1.0f:.48f),a=ring?.020f:.042f;V3 q[4]={v3(p.x-r,0,p.z-r),v3(p.x+r,0,p.z-r),v3(p.x+r,0,p.z+r),v3(p.x-r,0,p.z+r)};for(int k=0;k<4;k++)q[k].y=terrain11_height(q[k].x,q[k].z)+.055f;glColor4f(1.0f,.55f,.18f,a);for(int k=0;k<4;k++)glVertex3f(q[k].x,q[k].y,q[k].z);}g_lighting500_pools++;}
static void lighting500_emit(V3 p,float scale,int*cap){if(*cap<=0)return;float dx=p.x-g_player.body.p.x,dz=p.z-g_player.body.p.z,d2=dx*dx+dz*dz;if(d2>430.0f*430.0f)return;lighting500_head_emit(p,scale);if(d2<185.0f*185.0f)lighting500_pool_emit(p,5.3f*scale);(*cap)--;}
static void lighting500_draw(void){g_lighting500_lamps=g_lighting500_pools=0;if(!g_renderer09_linear_output||!g_stream_ready08)return;int dark=(g_hour<6||g_hour>=18);if(!dark&&g_weather<2)return;int cap=g_perf80_quality==0?18:(g_perf80_quality==1?30:46);renderer09_suspend_shader();glDisable(GL_TEXTURE_2D);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE);glDepthMask(FALSE);glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08&&cap>0;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;RoadWay*r=&g_world.roads[s->road];V3 d=vsub(s->b,s->a),m=vmul(vadd(s->a,s->b),.5f);float len=vlen(d);if(len<3.0f)continue;float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>450.0f*450.0f)continue;V3 f=vmul(d,1.0f/maxf(1.0f,len)),rt=v3(f.z,0,-f.x);float edge=r->width*.5f+2.0f;u32 h=roads130_hash(s);int sec=urban10_sector_at(m,NULL);int beira=city330_contains_ci(r->name,"Victor Konder")||city330_contains_ci(r->name,"Beira-Rio")||city330_contains_ci(r->name,"Beira Rio");if(beira&&(h%3u)==0u){float side=city360_water_side(s,edge+3.0f);lighting500_emit(vadd(m,vmul(rt,side*(edge+4.0f))),1.02f,&cap);continue;}if((sec==0||sec==1)&&(h%7u)==0u){lighting500_emit(vadd(m,vmul(rt,edge+1.2f)),1.0f,&cap);continue;}if(sec==2&&(h%13u)==3u){lighting500_emit(vadd(m,vmul(rt,edge+2.0f)),1.10f,&cap);continue;}int zone=city400_outer_zone(m);u32 h4=h^0x40040u;int highway=str_eq(r->type,"motorway")||str_eq(r->type,"trunk"),arterial=highway||str_eq(r->type,"primary")||str_eq(r->type,"secondary")||str_eq(r->type,"tertiary");if(zone==1&&(h4%7u)==1u){lighting500_emit(vadd(m,vmul(rt,edge+1.0f)),.96f,&cap);continue;}if(zone==2&&(h4%13u)==3u){lighting500_emit(vadd(m,vmul(rt,edge+2.2f)),1.05f,&cap);continue;}if(zone>=3&&arterial&&(h4%19u)==4u){lighting500_emit(vadd(m,vmul(rt,edge+2.1f)),.98f,&cap);continue;}u32 h5=h^0x500D17u;if(!highway&&(h5%11u)==3u&&((h5>>5)&1u)==0u){float side=(h5&2u)?1.0f:-1.0f;lighting500_emit(vadd(m,vmul(rt,side*(edge+2.3f))),.92f,&cap);}}glEnd();glDepthMask(TRUE);glDisable(GL_BLEND);renderer09_resume_shader();if(g_lighting500_lamps)g_draw_calls++;}
static void lighting500_overlay(void){if(!g_debug||g_settings_menu_open||(g_photo70&&g_photo70_hide_hud))return;settings_draw_2d_begin();char b[150];sprintf(b,"LIGHT 5.0 // lamps %d | ground pools %d",g_lighting500_lamps,g_lighting500_pools);gl_text((float)g_w-462,108,b,.82f,.72f,.52f);settings_draw_2d_end();}
