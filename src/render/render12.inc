// -----------------------------------------------------------------------------
// 0.12 exact footprint building renderer.
// 0.80 adds distance/quality LOD: nearby buildings keep exact OSM footprints,
// far buildings use lightweight volume silhouettes.
// -----------------------------------------------------------------------------
#ifndef GL_TRIANGLES
#define GL_TRIANGLES 0x0004
#endif
static void building12_color(const Building*b,float*r,float*g,float*bl){int cls=urban10_building_class(b);float v=((b->seed>>8)&255)/255.0f;if(cls==BLD10_HOUSE){*r=.78f+v*.10f;*g=.70f+v*.10f;*bl=.60f+v*.12f;}else if(cls==BLD10_APARTMENT){*r=.72f+v*.12f;*g=.74f+v*.12f;*bl=.78f+v*.12f;}else if(cls==BLD10_COMMERCIAL){*r=.62f+v*.12f;*g=.68f+v*.13f;*bl=.74f+v*.15f;}else if(cls==BLD10_INDUSTRIAL){*r=.55f+v*.10f;*g=.57f+v*.10f;*bl=.58f+v*.10f;}else if(cls==BLD10_CIVIC){*r=.76f+v*.12f;*g=.72f+v*.10f;*bl=.64f+v*.08f;}else{*r=.70f+v*.15f;*g=.70f+v*.14f;*bl=.68f+v*.13f;}}
static void building12_fallback(const Building*b){int cls=urban10_building_class(b);float r,g,bl;building12_color(b,&r,&g,&bl);renderer09_set_material(3);draw_box(b->c,b->sx,b->h,b->sz,0,r,g,bl);renderer09_set_material(0);urban10_building_detail((Building*)b,cls);}
static void building12_lodbox(const Building*b){float r,g,bl;building12_color(b,&r,&g,&bl);renderer09_set_material(3);draw_box(b->c,b->sx,b->h,b->sz,0,r*.94f,g*.94f,bl*.94f);renderer09_set_material(0);g_perf80_lod_buildings++;}
static void building12_draw_exact(const Building*b,int id){if(id<0||id>=g_world.buildingCount){building12_fallback(b);return;}int n=g_building_poly_count12[id],s=g_building_poly_start12[id];if(n<3||s<0||s+n>g_building_vert_count12){building12_fallback(b);return;}float r,g,bl;building12_color(b,&r,&g,&bl);renderer09_set_material(3);glColor3f(r,g,bl);glBegin(GL_QUADS);for(int i=0;i<n;i++){V3 a=g_building_verts12[s+i],c=g_building_verts12[s+(i+1)%n],d=vsub(c,a);float len=maxf(.1f,vlen(d));V3 normal=vnorm(v3(d.z,0,-d.x));glNormal3f(normal.x,normal.y,normal.z);glTexCoord2f(0,0);glVertex3f(a.x,.02f,a.z);glTexCoord2f(len*.12f,0);glVertex3f(c.x,.02f,c.z);glTexCoord2f(len*.12f,b->h*.10f);glVertex3f(c.x,b->h,c.z);glTexCoord2f(0,b->h*.10f);glVertex3f(a.x,b->h,a.z);}glEnd();V3 center=v3(0,b->h,0);for(int i=0;i<n;i++){center.x+=g_building_verts12[s+i].x;center.z+=g_building_verts12[s+i].z;}center.x/=n;center.z/=n;glColor3f(r*.88f,g*.88f,bl*.88f);glNormal3f(0,1,0);glBegin(GL_TRIANGLES);for(int i=0;i<n;i++){V3 a=g_building_verts12[s+i],c=g_building_verts12[s+(i+1)%n];glTexCoord2f(.5f,.5f);glVertex3f(center.x,b->h+.03f,center.z);glTexCoord2f(0,0);glVertex3f(a.x,b->h+.03f,a.z);glTexCoord2f(1,0);glVertex3f(c.x,b->h+.03f,c.z);}glEnd();renderer09_set_material(0);g_draw_calls+=2;g_perf80_exact_buildings++;}
static void draw_ground(void){draw_ground_legacy11();}
static void draw_roads(void){draw_roads_legacy11();}
static void draw_buildings(void){g_perf80_exact_buildings=0;g_perf80_lod_buildings=0;if(!g_stream_ready08||g_stream_building_count08<=0){draw_buildings_legacy11();return;}float exact2=g_perf80_exact_building_range*g_perf80_exact_building_range;for(int i=0;i<g_stream_building_count08;i++){Building*b=&g_stream_buildings08[i].b;float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z,ds=dx*dx+dz*dz;if(ds>650*650)continue;if(ds>exact2){building12_lodbox(b);continue;}int id=building12_find_seed(b->seed);building12_draw_exact(b,id);}urban10_draw_assets();}
static void draw_hud(float fps){draw_hud_legacy11(fps);if(g_settings_menu_open)return;settings_draw_2d_begin();hud_panel(20,20,520,31);gl_text(34,43,"ITAJAI DRIVE // NATIVE ENGINE 0.12.0",.92f,.95f,1);if(g_debug){char b[180];hud_panel(835,(float)g_h-185,420,31);sprintf(b,"FOOTPRINTS OSM: %d | VERTS %d",g_building_polys12,g_building_vert_count12);gl_text(850,(float)g_h-162,b,.65f,.92f,.72f);}settings_draw_2d_end();}
