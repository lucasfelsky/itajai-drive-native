// -----------------------------------------------------------------------------
// 0.12 exact footprint building renderer.
// 0.80 adds distance/quality LOD; 1.5 anchors footprint geometry to terrain.
// Renderer 5.0 facade pass 2 adds seed/class UV variation and clean untextured
// roofs/LOD shells so OSM buildings do not read as identical stamped boxes.
// -----------------------------------------------------------------------------
#ifndef GL_TRIANGLES
#define GL_TRIANGLES 0x0004
#endif
static void building12_color(const Building*b,float*r,float*g,float*bl){int cls=urban10_building_class(b);float v=((b->seed>>8)&255)/255.0f;if(cls==BLD10_HOUSE){*r=.78f+v*.10f;*g=.70f+v*.10f;*bl=.60f+v*.12f;}else if(cls==BLD10_APARTMENT){*r=.72f+v*.12f;*g=.74f+v*.12f;*bl=.78f+v*.12f;}else if(cls==BLD10_COMMERCIAL){*r=.62f+v*.12f;*g=.68f+v*.13f;*bl=.74f+v*.15f;}else if(cls==BLD10_INDUSTRIAL){*r=.55f+v*.10f;*g=.57f+v*.10f;*bl=.58f+v*.10f;}else if(cls==BLD10_CIVIC){*r=.76f+v*.12f;*g=.72f+v*.10f;*bl=.64f+v*.08f;}else{*r=.70f+v*.15f;*g=.70f+v*.14f;*bl=.68f+v*.13f;}}
static void building12_uv_profile(const Building*b,float*scale,float*u0,float*v0){int cls=urban10_building_class(b);float s=.043f;if(cls==BLD10_HOUSE)s=.040f;else if(cls==BLD10_APARTMENT)s=.044f;else if(cls==BLD10_COMMERCIAL)s=.038f;else if(cls==BLD10_INDUSTRIAL)s=.026f;else if(cls==BLD10_CIVIC)s=.034f;float jitter=.93f+(float)((b->seed>>17)&15)*.01f;*scale=s*jitter;*u0=(float)((b->seed>>3)&7)*.125f;*v0=(float)((b->seed>>9)&7)*.125f;}
static void building12_fallback(const Building*b){int cls=urban10_building_class(b);float r,g,bl;building12_color(b,&r,&g,&bl);V3 c=b->c;c.y=terrain11_height(c.x,c.z)+b->h*.5f;renderer09_set_material(0);draw_box(c,b->sx,b->h,b->sz,0,r,g,bl);urban10_building_detail((Building*)b,cls);}
static void building12_lodbox(const Building*b){float r,g,bl;building12_color(b,&r,&g,&bl);V3 c=b->c;c.y=terrain11_height(c.x,c.z)+b->h*.5f;renderer09_set_material(0);draw_box(c,b->sx,b->h,b->sz,0,r*.94f,g*.94f,bl*.94f);g_perf80_lod_buildings++;}
static void building12_draw_exact(const Building*b,int id){if(id<0||id>=g_world.buildingCount){building12_fallback(b);return;}int n=g_building_poly_count12[id],s=g_building_poly_start12[id];if(n<3||s<0||s+n>g_building_vert_count12){building12_fallback(b);return;}float base=terrain11_height(b->c.x,b->c.z),top=base+b->h;float r,g,bl,uvs,u0,v0;building12_color(b,&r,&g,&bl);building12_uv_profile(b,&uvs,&u0,&v0);renderer09_set_material(3);glColor3f(r,g,bl);glBegin(GL_QUADS);for(int i=0;i<n;i++){V3 a=g_building_verts12[s+i],c=g_building_verts12[s+(i+1)%n],d=vsub(c,a);float len=maxf(.1f,vlen(d));V3 normal=vnorm(v3(d.z,0,-d.x));glNormal3f(normal.x,normal.y,normal.z);glTexCoord2f(u0,v0);glVertex3f(a.x,base+.02f,a.z);glTexCoord2f(u0+len*uvs,v0);glVertex3f(c.x,base+.02f,c.z);glTexCoord2f(u0+len*uvs,v0+b->h*uvs);glVertex3f(c.x,top,c.z);glTexCoord2f(u0,v0+b->h*uvs);glVertex3f(a.x,top,c.z);}glEnd();renderer09_set_material(0);V3 center=v3(0,top,0);for(int i=0;i<n;i++){center.x+=g_building_verts12[s+i].x;center.z+=g_building_verts12[s+i].z;}center.x/=n;center.z/=n;glColor3f(r*.86f,g*.86f,bl*.86f);glNormal3f(0,1,0);glBegin(GL_TRIANGLES);for(int i=0;i<n;i++){V3 a=g_building_verts12[s+i],c=g_building_verts12[s+(i+1)%n];glVertex3f(center.x,top+.03f,center.z);glVertex3f(a.x,top+.03f,a.z);glVertex3f(c.x,top+.03f,c.z);}glEnd();urban10_building_detail((Building*)b,urban10_building_class(b));g_draw_calls+=2;g_perf80_exact_buildings++;}
static void draw_ground(void){draw_ground_legacy11();}
static void draw_roads(void){draw_roads_legacy11();}
static void draw_buildings(void){g_perf80_exact_buildings=0;g_perf80_lod_buildings=0;if(!g_stream_ready08||g_stream_building_count08<=0){draw_buildings_legacy11();return;}float exact2=g_perf80_exact_building_range*g_perf80_exact_building_range;for(int i=0;i<g_stream_building_count08;i++){Building*b=&g_stream_buildings08[i].b;float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z,ds=dx*dx+dz*dz;if(ds>650*650)continue;if(ds>exact2){building12_lodbox(b);continue;}int id=building12_find_seed(b->seed);building12_draw_exact(b,id);}urban10_draw_assets();}
static void draw_hud(float fps){draw_hud_legacy11(fps);if(g_settings_menu_open)return;settings_draw_2d_begin();hud_panel(20,20,520,31);gl_text(34,43,"ITAJAI DRIVE // NATIVE ENGINE 0.12.0",.92f,.95f,1);if(g_debug){char b[180];hud_panel(835,(float)g_h-185,420,31);sprintf(b,"FOOTPRINTS OSM: %d | VERTS %d",g_building_polys12,g_building_vert_count12);gl_text(850,(float)g_h-162,b,.65f,.92f,.72f);}settings_draw_2d_end();}
