static void renderer14_draw_wet_reflections(void){if(g_weather<2||!g_stream_ready08)return;renderer09_suspend_shader();glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>190*190)continue;V3 d=vsub(s->b,s->a);float l=vlen(d);if(l<2)continue;V3 r=v3(d.z/l,0,-d.x/l);float w=minf(1.4f,g_world.roads[s->road].width*.13f);V3 a1=vadd(s->a,vmul(r,w)),a2=vsub(s->a,vmul(r,w)),b1=vadd(s->b,vmul(r,w)),b2=vsub(s->b,vmul(r,w));float pulse=.035f+.022f*(float)(0.5+0.5*sin((double)(g_time*.8+i*.37)));glColor4f(.55f,.70f,.85f,pulse*(g_weather==3?1.8f:1.0f));glVertex3f(a1.x,.034f,a1.z);glVertex3f(a2.x,.034f,a2.z);glVertex3f(b2.x,.034f,b2.z);glVertex3f(b1.x,.034f,b1.z);}glEnd();glDisable(GL_BLEND);renderer09_resume_shader();g_draw_calls++;}
