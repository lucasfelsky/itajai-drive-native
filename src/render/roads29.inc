  for(int k=0;k<stripes;k++){float off=(k-(stripes-1)*.5f);V3 c=vadd(center,vmul(rr,off));V3 a=vadd(vadd(c,vmul(f,-1.45f)),vmul(rr,-.25f)),b=vadd(vadd(c,vmul(f,-1.45f)),vmul(rr,.25f)),q=vadd(vadd(c,vmul(f,1.45f)),vmul(rr,.25f)),e=vadd(vadd(c,vmul(f,1.45f)),vmul(rr,-.25f));glColor3f(.80f,.80f,.75f);glVertex3f(a.x,y,a.z);glVertex3f(b.x,y,b.z);glVertex3f(q.x,y,q.z);glVertex3f(e.x,y,e.z);}g_roads29_crosswalks++;
  V3 bar=vadd(center,vmul(f,atEnd?-3.25f:3.25f));float by=roads130_height(bar.x,bar.z)+.064f;V3 a=vadd(vadd(bar,vmul(f,-.12f)),vmul(rr,-half)),b=vadd(vadd(bar,vmul(f,-.12f)),vmul(rr,half)),q=vadd(vadd(bar,vmul(f,.12f)),vmul(rr,half)),e=vadd(vadd(bar,vmul(f,.12f)),vmul(rr,-half));glColor3f(.94f,.94f,.90f);glVertex3f(a.x,by,a.z);glVertex3f(b.x,by,b.z);glVertex3f(q.x,by,q.z);glVertex3f(e.x,by,e.z);g_roads29_stopbars++;
}
static void roads29_arrow(StreamRoad08*s){V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<22||s->road<0||s->road>=g_world.roadCount)return;RoadWay*r=&g_world.roads[s->road];if(r->width<7.0f)return;V3 f=vmul(d,1.0f/len),rr=v3(f.z,0,-f.x),m=vmul(vadd(s->a,s->b),.5f);float y=roads130_height(m.x,m.z)+.065f;float laneOff=r->oneway?0:r->width*.24f;for(int side=r->oneway?0:-1;side<=1;side+=r->oneway?2:2){float off=r->oneway?0:side*laneOff;V3 c=vadd(m,vmul(rr,off)),tip=vadd(c,vmul(f,1.45f)),tail=vadd(c,vmul(f,-1.35f));V3 l=vadd(c,vmul(rr,-.40f)),ri=vadd(c,vmul(rr,.40f));glColor3f(.90f,.90f,.86f);glVertex3f(tip.x,y,tip.z);glVertex3f(l.x,y,l.z);glVertex3f(ri.x,y,ri.z);glVertex3f(l.x,y,l.z);glVertex3f(ri.x,y,ri.z);glVertex3f(tail.x,y,tail.z);g_roads29_arrows++;if(r->oneway)break;}}
static void roads29_draw_sign(StreamRoad08*s){if(!roads29_urban_road(s->road))return;u32 h=roads130_hash(s);if((h%41u)!=5u)return;V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<16)return;V3 f=vmul(d,1.0f/len),rr=v3(f.z,0,-f.x),m=vmul(vadd(s->a,s->b),.5f);float half=g_world.roads[s->road].width*.5f;float side=(h&1u)?1.0f:-1.0f;V3 p=vadd(m,vmul(rr,side*(half+1.65f)));float base=terrain11_height(p.x,p.z);draw_box(v3(p.x,base+1.05f,p.z),.08f,2.1f,.08f,0,.48f,.49f,.47f);draw_box(v3(p.x,base+2.02f,p.z),.78f,.72f,.08f,(float)atan2((double)f.x,(double)f.z),.72f,.09f,.08f);g_roads29_signs++;}
static void roads29_draw(void){
  if(!g_stream_ready08)return;g_roads29_crosswalks=g_roads29_stopbars=g_roads29_arrows=g_roads29_signs=0;renderer09_suspend_shader();glDisable(GL_TEXTURE_2D);glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>280.0f*280.0f)continue;u32 h=roads130_hash(s);int signalA=roads29_near_signal(s->a,9.0f),signalB=roads29_near_signal(s->b,9.0f);if(signalA||(!signalB&&(h%29u)==3u))roads29_crosswalk(s,0);if(signalB)roads29_crosswalk(s,1);}glEnd();glBegin(GL_TRIANGLES);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>220.0f*220.0f)continue;if((roads130_hash(s)%9u)==2u)roads29_arrow(s);}glEnd();renderer09_resume_shader();for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz<190.0f*190.0f)roads29_draw_sign(s);}g_draw_calls+=2;}
