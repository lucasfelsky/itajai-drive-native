    else if(sec>=3){if((h%8u)==0u)city360_asset(g_city360_palm,vadd(m,vmul(rt,edge+2.6f)),yaw,.98f,.20f,.52f,.22f);if((h%10u)==3u)city360_asset(g_city360_tree,vadd(m,vmul(rt,-edge-2.7f)),yaw,.88f,.20f,.48f,.20f);if((sec==4||sec==5)&&(h%6u)==1u)city360_asset(g_city360_guard,vadd(m,vmul(rt,edge+1.0f)),yaw,1.0f,.46f,.47f,.46f);}
