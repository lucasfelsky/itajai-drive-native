// -----------------------------------------------------------------------------
// 0.10 urban renderer: sidewalks/medians, building archetypes and sector props.
// Building placement is terrain-aware from the 1.5 identity pass onward.
// -----------------------------------------------------------------------------
static void urban10_draw_sidewalks(void){if(!g_stream_ready08||g_stream_road_count08<=0)return;renderer09_set_material(0);glNormal3f(0,1,0);glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;RoadWay*r=&g_world.roads[s->road];if(str_eq(r->type,"motorway")||str_eq(r->type,"trunk")||str_eq(r->type,"service"))continue;V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>540*540)continue;V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<1)continue;V3 rt=v3(d.z/len,0,-d.x/len);float half=r->width*.5f,sw=r->width>=11?1.8f:1.35f;float ya=terrain11_height(s->a.x,s->a.z)+.075f,yb=terrain11_height(s->b.x,s->b.z)+.075f;glColor3f(.60f,.61f,.60f);for(int side=-1;side<=1;side+=2){float a=side*half,b=side*(half+sw);V3 p0=vadd(s->a,vmul(rt,a)),p1=vadd(s->a,vmul(rt,b)),p2=vadd(s->b,vmul(rt,b)),p3=vadd(s->b,vmul(rt,a));glVertex3f(p0.x,ya,p0.z);glVertex3f(p1.x,ya,p1.z);glVertex3f(p2.x,yb,p2.z);glVertex3f(p3.x,yb,p3.z);}if(!r->oneway&&r->width>=14.0f){float mw=minf(1.4f,r->width*.09f);glColor3f(.30f,.43f,.25f);V3 p0=vsub(s->a,vmul(rt,mw*.5f)),p1=vadd(s->a,vmul(rt,mw*.5f)),p2=vadd(s->b,vmul(rt,mw*.5f)),p3=vsub(s->b,vmul(rt,mw*.5f));glVertex3f(p0.x,ya+.01f,p0.z);glVertex3f(p1.x,ya+.01f,p1.z);glVertex3f(p2.x,yb+.01f,p2.z);glVertex3f(p3.x,yb+.01f,p3.z);}}glEnd();renderer09_set_material(0);g_draw_calls++;}

static void draw_roads(void){draw_roads_legacy09();urban10_draw_sidewalks();}

static void urban10_building_detail(Building*b,int cls){float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z;if(dx*dx+dz*dz>280*280)return;float base=terrain11_height(b->c.x,b->c.z),top=base+b->h;if(cls==BLD10_HOUSE){draw_box(v3(b->c.x,top+.14f,b->c.z),b->sx*.92f,.28f,b->sz*.92f,0,.38f,.20f,.16f);}else if(cls==BLD10_APARTMENT){draw_box(v3(b->c.x,top+.20f,b->c.z),maxf(2.5f,b->sx*.34f),.40f,maxf(2.5f,b->sz*.34f),0,.42f,.45f,.48f);draw_box(v3(b->c.x,base+1.0f,b->c.z),b->sx*1.03f,2.0f,b->sz*1.03f,0,.54f,.55f,.56f);}else if(cls==BLD10_COMMERCIAL){draw_box(v3(b->c.x,base+1.45f,b->c.z+b->sz*.5f+.08f),b->sx*.84f,2.65f,.16f,0,.16f,.25f,.31f);draw_box(v3(b->c.x,top+.10f,b->c.z),b->sx*.96f,.20f,b->sz*.96f,0,.40f,.42f,.43f);}else if(cls==BLD10_INDUSTRIAL){draw_box(v3(b->c.x,top+.12f,b->c.z),b->sx*.72f,.24f,maxf(1.2f,b->sz*.14f),0,.58f,.60f,.60f);if(b->sx>16)draw_box(v3(b->c.x+b->sx*.28f,top+.32f,b->c.z),1.3f,.65f,1.3f,0,.36f,.38f,.39f);}else if(cls==BLD10_CIVIC){draw_box(v3(b->c.x,top+.20f,b->c.z),b->sx*.70f,.40f,b->sz*.70f,0,.76f,.74f,.67f);}}

static void draw_buildings(void){if(!g_stream_ready08||g_stream_building_count08<=0){draw_buildings_legacy09();return;}renderer09_set_material(3);for(int i=0;i<g_stream_building_count08;i++){Building*b=&g_stream_buildings08[i].b;float dx=b->c.x-g_player.body.p.x,dz=b->c.z-g_player.body.p.z,ds=dx*dx+dz*dz;if(ds>560*560)continue;int cls=urban10_building_class(b);float q=(float)((b->seed>>8)&255)/255.0f,r=.70f,g=.70f,bl=.68f;if(cls==BLD10_HOUSE){r=.72f+.12f*q;g=.62f+.10f*q;bl=.52f+.08f*q;}else if(cls==BLD10_APARTMENT){r=.70f+.12f*q;g=.73f+.10f*q;bl=.77f+.10f*q;}else if(cls==BLD10_COMMERCIAL){r=.62f+.10f*q;g=.68f+.10f*q;bl=.70f+.12f*q;}else if(cls==BLD10_INDUSTRIAL){r=.55f+.08f*q;g=.56f+.08f*q;bl=.55f+.08f*q;}else if(cls==BLD10_CIVIC){r=.79f;g=.76f;bl=.67f;}else{r=.69f+.16f*q;g=.69f+.13f*q;bl=.66f+.12f*q;}V3 c=b->c;c.y=terrain11_height(c.x,c.z)+b->h*.5f;draw_box(c,b->sx,b->h,b->sz,0,r,g,bl);urban10_building_detail(b,cls);}renderer09_set_material(0);urban10_draw_assets();}

static void draw_hud(float fps){draw_hud_legacy09(fps);if(g_settings_menu_open)return;settings_draw_2d_begin();hud_panel(20,20,500,31);gl_text(34,43,"ITAJAI DRIVE // NATIVE ENGINE 0.10.0",.92f,.95f,1);hud_panel(20,201,330,47);char b[240];sprintf(b,"SETOR: %s",urban10_sector_name());gl_text(34,230,b,.66f,.88f,1);if(g_debug){hud_panel(835,(float)g_h-116,420,88);sprintf(b,"WORLD10 roads %d segs %d",g_world.roadCount,g_world.segCount);gl_text(850,(float)g_h-89,b,.68f,.84f,.94f);sprintf(b,"buildings %d nodes %d edges %d",g_world.buildingCount,g_world.nodeCount,g_world.edgeCount);gl_text(850,(float)g_h-67,b,.68f,.84f,.94f);sprintf(b,"props %d | lamps %d green %d port %d",g_asset_instance_count08,g_props_by_type10[0],g_props_by_type10[1],g_props_by_type10[2]);gl_text(850,(float)g_h-45,b,.68f,.84f,.94f);}settings_draw_2d_end();}
