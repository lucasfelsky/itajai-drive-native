static void roads130_strip(const StreamRoad08*s,float offset,float halfWidth,float yAdd,float cr,float cg,float cb){
  V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<.05f)return;V3 rt=v3(d.z/len,0,-d.x/len);V3 ac=vadd(s->a,vmul(rt,offset)),bc=vadd(s->b,vmul(rt,offset));V3 a0=vsub(ac,vmul(rt,halfWidth)),a1=vadd(ac,vmul(rt,halfWidth)),b0=vsub(bc,vmul(rt,halfWidth)),b1=vadd(bc,vmul(rt,halfWidth));float ya=roads130_height(ac.x,ac.z)+yAdd,yb=roads130_height(bc.x,bc.z)+yAdd;glColor3f(cr,cg,cb);glNormal3f(0,1,0);glTexCoord2f(0,0);glVertex3f(a0.x,ya,a0.z);glTexCoord2f(1,0);glVertex3f(a1.x,ya,a1.z);glTexCoord2f(1,len*.12f);glVertex3f(b1.x,yb,b1.z);glTexCoord2f(0,len*.12f);glVertex3f(b0.x,yb,b0.z);
}
static void roads130_dashed(const StreamRoad08*s,float offset,float halfWidth,float yAdd,float cr,float cg,float cb){
  V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<2)return;V3 dir=vmul(d,1.0f/len),rt=v3(dir.z,0,-dir.x);for(float p=1.0f;p<len;p+=9.0f){float e=minf(len,p+4.2f);V3 a=vadd(s->a,vmul(dir,p)),b=vadd(s->a,vmul(dir,e)),ac=vadd(a,vmul(rt,offset)),bc=vadd(b,vmul(rt,offset));V3 a0=vsub(ac,vmul(rt,halfWidth)),a1=vadd(ac,vmul(rt,halfWidth)),b0=vsub(bc,vmul(rt,halfWidth)),b1=vadd(bc,vmul(rt,halfWidth));float ya=roads130_height(ac.x,ac.z)+yAdd,yb=roads130_height(bc.x,bc.z)+yAdd;glColor3f(cr,cg,cb);glVertex3f(a0.x,ya,a0.z);glVertex3f(a1.x,ya,a1.z);glVertex3f(b1.x,yb,b1.z);glVertex3f(b0.x,yb,b0.z);}}
static void roads130_patch(const StreamRoad08*s){
  if(!roads130_has_patch(s))return;V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<8)return;V3 dir=vmul(d,1.0f/len),rt=v3(dir.z,0,-dir.x);u32 h=roads130_hash(s);float along=.34f+.28f*((h>>8)&255)/255.0f,off=((((h>>16)&255)/255.0f)-.5f)*minf(3.0f,g_world.roads[s->road].width*.45f);V3 m=vadd(vadd(s->a,vmul(d,along)),vmul(rt,off));float hl=1.2f+((h>>24)&7)*.16f,hw=.55f+((h>>20)&7)*.10f,y=roads130_height(m.x,m.z)+.038f;V3 a=vadd(vadd(m,vmul(dir,-hl)),vmul(rt,-hw)),b=vadd(vadd(m,vmul(dir,-hl)),vmul(rt,hw)),c=vadd(vadd(m,vmul(dir,hl)),vmul(rt,hw)),q=vadd(vadd(m,vmul(dir,hl)),vmul(rt,-hw));glColor3f(.20f,.21f,.22f);glVertex3f(a.x,y,a.z);glVertex3f(b.x,y,b.z);glVertex3f(c.x,y,c.z);glVertex3f(q.x,y,q.z);
}
static void roads130_transverse_quad(const StreamRoad08*s,float halfAlong,float halfAcross,float yAdd,float cr,float cg,float cb){V3 d=vsub(s->b,s->a);float len=vlen(d);if(len<.1f)return;V3 f=vmul(d,1.0f/len),rt=v3(f.z,0,-f.x),m=vmul(vadd(s->a,s->b),.5f);float y=roads130_height(m.x,m.z)+yAdd;V3 a=vadd(vadd(m,vmul(f,-halfAlong)),vmul(rt,-halfAcross)),b=vadd(vadd(m,vmul(f,-halfAlong)),vmul(rt,halfAcross)),c=vadd(vadd(m,vmul(f,halfAlong)),vmul(rt,halfAcross)),q=vadd(vadd(m,vmul(f,halfAlong)),vmul(rt,-halfAcross));glColor3f(cr,cg,cb);glVertex3f(a.x,y,a.z);glVertex3f(b.x,y,b.z);glVertex3f(c.x,y,c.z);glVertex3f(q.x,y,q.z);}
static void roads130_draw_detail(void){
  if(!g_stream_ready08)return;g_road_detail_segments130=0;g_road_bumps_visible130=0;g_road_bike_segments130=0;
  // Elevated asphalt deck.
  renderer09_set_material(2);glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>620.0f*620.0f)continue;float half=g_world.roads[s->road].width*.5f;roads130_strip(s,0,half,.004f,.82f,.83f,.84f);g_road_detail_segments130++;}glEnd();renderer09_set_material(0);g_draw_calls++;
  // Urban shoulders, curb tops and gutters.
  glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>420.0f*420.0f)continue;RoadWay*r=&g_world.roads[s->road];float half=r->width*.5f;if(!str_eq(r->type,"motorway")&&!str_eq(r->type,"trunk")&&!str_eq(r->type,"service")){roads130_strip(s,half+.95f,.72f,.075f,.57f,.58f,.58f);roads130_strip(s,-half-.95f,.72f,.075f,.57f,.58f,.58f);roads130_strip(s,half+.10f,.10f,.125f,.69f,.69f,.67f);roads130_strip(s,-half-.10f,.10f,.125f,.69f,.69f,.67f);roads130_strip(s,half-.16f,.11f,.026f,.24f,.25f,.26f);roads130_strip(s,-half+.16f,.11f,.026f,.24f,.25f,.26f);}if(roads130_has_bike_lane(s)){float off=half-.82f;roads130_strip(s,off,.62f,.032f,.50f,.15f,.13f);roads130_strip(s,off-.72f,.045f,.040f,.88f,.88f,.84f);g_road_bike_segments130++;}roads130_patch(s);if(roads130_has_bump(s)){roads130_transverse_quad(s,.48f,maxf(.8f,half-.18f),.085f,.64f,.55f,.23f);g_road_bumps_visible130++;}if(roads130_has_drain(s)){u32 h=roads130_hash(s);float side=(h&1)?1.0f:-1.0f;float off=side*(half-.35f);V3 d=vsub(s->b,s->a);float len=vlen(d);if(len>.1f){V3 f=vmul(d,1.0f/len),rt=v3(f.z,0,-f.x),p=vadd(vmul(vadd(s->a,s->b),.5f),vmul(rt,off));float y=roads130_height(p.x,p.z)+.042f;V3 a=vadd(vadd(p,vmul(f,-.38f)),vmul(rt,-.20f)),b=vadd(vadd(p,vmul(f,-.38f)),vmul(rt,.20f)),c=vadd(vadd(p,vmul(f,.38f)),vmul(rt,.20f)),q=vadd(vadd(p,vmul(f,.38f)),vmul(rt,-.20f));glColor3f(.12f,.13f,.14f);glVertex3f(a.x,y,a.z);glVertex3f(b.x,y,b.z);glVertex3f(c.x,y,c.z);glVertex3f(q.x,y,q.z);}}}glEnd();g_draw_calls++;
  // Fresh road paint above the graded deck.
  glDisable(GL_TEXTURE_2D);glBegin(GL_QUADS);for(int i=0;i<g_stream_road_count08;i++){StreamRoad08*s=&g_stream_roads08[i];if(s->road<0||s->road>=g_world.roadCount)continue;V3 m=vmul(vadd(s->a,s->b),.5f);float dx=m.x-g_player.body.p.x,dz=m.z-g_player.body.p.z;if(dx*dx+dz*dz>470.0f*470.0f)continue;RoadWay*r=&g_world.roads[s->road];float half=r->width*.5f;roads130_strip(s,half-.27f,.038f,.048f,.88f,.88f,.84f);roads130_strip(s,-half+.27f,.038f,.048f,.88f,.88f,.84f);int lanes=road_total_lanes(s->road);if(!r->oneway){roads130_strip(s,0,.055f,.051f,.94f,.73f,.18f);int per=lanes/2;float lw=half/maxf(1,(float)per);for(int k=1;k<per;k++){roads130_dashed(s,lw*k,.040f,.050f,.91f,.91f,.88f);roads130_dashed(s,-lw*k,.040f,.050f,.91f,.91f,.88f);}}else if(lanes>1){float lw=r->width/maxf(1,(float)lanes);for(int k=1;k<lanes;k++)roads130_dashed(s,half-lw*k,.040f,.050f,.91f,.91f,.88f);}}glEnd();g_draw_calls++;
}
