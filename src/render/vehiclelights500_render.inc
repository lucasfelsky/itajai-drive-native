// -----------------------------------------------------------------------------
// Renderer 5.0 emissive vehicle lamps. Geometry/materials still own the physical
// lenses; this additive pass gives lit head/tail lamps HDR energy so bloom and wet
// road highlights respond to the cars instead of treating lenses as painted quads.
// On wet asphalt a narrow reflection is projected directly from each vehicle lamp
// pair, keeping the streak spatially tied to the moving source.
// -----------------------------------------------------------------------------
static int g_vlight500_front=0,g_vlight500_brake=0,g_vlight500_wet=0;
static void vlight500_panel(V3 c,V3 side,float hw,float hh,float r,float g,float b,float a){glColor4f(r,g,b,a);glVertex3f(c.x-side.x*hw,c.y-hh,c.z-side.z*hw);glVertex3f(c.x+side.x*hw,c.y-hh,c.z+side.z*hw);glVertex3f(c.x+side.x*hw,c.y+hh,c.z+side.z*hw);glVertex3f(c.x-side.x*hw,c.y+hh,c.z-side.z*hw);}
static void vlight500_pair(V3 p,float yaw,float W,float L,int front,float strength){V3 f=v3((float)sin((double)yaw),0,(float)cos((double)yaw)),side=v3(f.z,0,-f.x);float z=(front?1.0f:-1.0f)*(L*.515f+.025f),sx=W*.30f;V3 base=vadd(p,vmul(f,z));base.y+=front?.02f:.05f;for(int s=-1;s<=1;s+=2){V3 c=vadd(base,vmul(side,s*sx));for(int layer=0;layer<3;layer++){float k=layer==0?1.0f:layer==1?1.8f:3.0f,a=strength*(layer==0?.68f:layer==1?.20f:.055f);if(front)vlight500_panel(c,side,W*.085f*k,.055f*k,1.0f,.82f,.48f,a);else vlight500_panel(c,side,W*.075f*k,.055f*k,1.0f,.035f,.018f,a);}}if(front)g_vlight500_front++;else g_vlight500_brake++;}
static void vlight500_wet_reflection(V3 p,float yaw,float W,float L,int front,float strength){float wet=clampf(g_wetness60,0,1);if(wet<.14f||strength<.04f)return;V3 f=v3((float)sin((double)yaw),0,(float)cos((double)yaw)),rt=v3(f.z,0,-f.x);float dir=front?1.0f:-1.0f,start=(L*.48f+.12f)*dir,len=front?(4.0f+wet*8.5f):(1.7f+wet*3.0f);float hw=front?W*.20f:W*.17f;V3 a=vadd(p,vmul(f,start)),b=vadd(a,vmul(f,len*dir));V3 q0=vadd(a,vmul(rt,-hw)),q1=vadd(a,vmul(rt,hw)),q2=vadd(b,vmul(rt,hw*.28f)),q3=vadd(b,vmul(rt,-hw*.28f));q0.y=roads130_height(q0.x,q0.z)+.064f;q1.y=roads130_height(q1.x,q1.z)+.064f;q2.y=roads130_height(q2.x,q2.z)+.064f;q3.y=roads130_height(q3.x,q3.z)+.064f;float a0=strength*wet*(front?.080f:.060f);if(front)glColor4f(1.0f,.76f,.42f,a0);else glColor4f(1.0f,.025f,.012f,a0);glVertex3f(q0.x,q0.y,q0.z);glVertex3f(q1.x,q1.y,q1.z);if(front)glColor4f(1.0f,.48f,.16f,.003f*strength);else glColor4f(.80f,.01f,.008f,.002f*strength);glVertex3f(q2.x,q2.y,q2.z);glVertex3f(q3.x,q3.y,q3.z);g_vlight500_wet++;}
static void vehiclelights500_draw(void){g_vlight500_front=g_vlight500_brake=g_vlight500_wet=0;if(!g_renderer09_linear_output||!g_started)return;float night=renderer500_night_factor(),lamp=clampf(night+(g_weather>=2?.42f:g_weather==1?.12f:0)+g_wetness60*.10f,0,1);int pbrake=key_down('S')||key_down(VK_SPACE);renderer09_suspend_shader();glDisable(GL_TEXTURE_2D);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE);glDepthMask(FALSE);glBegin(GL_QUADS);if(g_player.camera!=2){int model=g_player_model160[g_player.car&3];const CarVisual160*v=&g_car_visual160[model];if(lamp>.03f){vlight500_pair(g_player.body.p,g_player.body.yaw,v->w,v->l,1,lamp);vlight500_wet_reflection(g_player.body.p,g_player.body.yaw,v->w,v->l,1,lamp);}if(pbrake){vlight500_pair(g_player.body.p,g_player.body.yaw,v->w,v->l,0,.92f);vlight500_wet_reflection(g_player.body.p,g_player.body.yaw,v->w,v->l,0,.92f);}}int cap=g_perf80_quality==0?7:(g_perf80_quality==1?12:18);float maxD=g_perf80_quality==0?68.0f:(g_perf80_quality==1?95.0f:125.0f),d2max=maxD*maxD;for(int i=0;i<g_traffic_count&&cap>0;i++){Traffic*t=&g_traffic[i];if(!t->active)continue;float dx=t->p.x-g_player.body.p.x,dz=t->p.z-g_player.body.p.z,d2=dx*dx+dz*dz;if(d2>d2max)continue;int model=(i*5+i/3)&7;const CarVisual160*v=&g_car_visual160[model];float fade=.45f+.55f*(1.0f-clampf((float)sqrt((double)d2)/maxD,0,1));V3 tp=t->p;tp.y+=.10f;if(lamp>.03f){float s=.55f*fade*lamp;vlight500_pair(tp,t->yaw,v->w,v->l,1,s);if(d2<72.0f*72.0f)vlight500_wet_reflection(tp,t->yaw,v->w,v->l,1,s);}if(g_traffic_brake_amount[i]>.12f){float s=.66f*fade;vlight500_pair(tp,t->yaw,v->w,v->l,0,s);if(d2<62.0f*62.0f)vlight500_wet_reflection(tp,t->yaw,v->w,v->l,0,s);}cap--;}glEnd();glDepthMask(TRUE);glDisable(GL_BLEND);renderer09_resume_shader();if(g_vlight500_front||g_vlight500_brake||g_vlight500_wet)g_draw_calls++;}
static void vehiclelights500_overlay(void){if(!g_debug||g_settings_menu_open||(g_photo70&&g_photo70_hide_hud))return;settings_draw_2d_begin();char b[145];sprintf(b,"VEH LIGHT 5.0 // front %d | brake %d | wet streaks %d",g_vlight500_front,g_vlight500_brake,g_vlight500_wet);gl_text((float)g_w-462,146,b,.88f,.55f,.42f);settings_draw_2d_end();}
