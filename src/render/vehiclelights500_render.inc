// -----------------------------------------------------------------------------
// Renderer 5.0 emissive vehicle lamps. Geometry/materials still own the physical
// lenses; this additive pass gives lit head/tail lamps HDR energy so bloom and wet
// road highlights respond to the cars instead of treating lenses as painted quads.
// -----------------------------------------------------------------------------
static int g_vlight500_front=0,g_vlight500_brake=0;
static void vlight500_panel(V3 c,V3 side,float hw,float hh,float r,float g,float b,float a){glColor4f(r,g,b,a);glVertex3f(c.x-side.x*hw,c.y-hh,c.z-side.z*hw);glVertex3f(c.x+side.x*hw,c.y-hh,c.z+side.z*hw);glVertex3f(c.x+side.x*hw,c.y+hh,c.z+side.z*hw);glVertex3f(c.x-side.x*hw,c.y+hh,c.z-side.z*hw);}
static void vlight500_pair(V3 p,float yaw,float W,float L,int front,float strength){V3 f=v3((float)sin((double)yaw),0,(float)cos((double)yaw)),side=v3(f.z,0,-f.x);float z=(front?1.0f:-1.0f)*(L*.515f+.025f),sx=W*.30f;V3 base=vadd(p,vmul(f,z));base.y+=front?.02f:.05f;for(int s=-1;s<=1;s+=2){V3 c=vadd(base,vmul(side,s*sx));for(int layer=0;layer<3;layer++){float k=layer==0?1.0f:layer==1?1.8f:3.0f,a=strength*(layer==0?.68f:layer==1?.20f:.055f);if(front)vlight500_panel(c,side,W*.085f*k,.055f*k,1.0f,.82f,.48f,a);else vlight500_panel(c,side,W*.075f*k,.055f*k,1.0f,.035f,.018f,a);}}if(front)g_vlight500_front++;else g_vlight500_brake++;}
static void vehiclelights500_draw(void){g_vlight500_front=g_vlight500_brake=0;if(!g_renderer09_linear_output||!g_started)return;int lights=(g_hour<6||g_hour>=18||g_weather>=2);int pbrake=key_down('S')||key_down(VK_SPACE);renderer09_suspend_shader();glDisable(GL_TEXTURE_2D);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE);glDepthMask(FALSE);glBegin(GL_QUADS);if(g_player.camera!=2){int model=g_player_model160[g_player.car&3];const CarVisual160*v=&g_car_visual160[model];if(lights)vlight500_pair(g_player.body.p,g_player.body.yaw,v->w,v->l,1,1.0f);if(pbrake)vlight500_pair(g_player.body.p,g_player.body.yaw,v->w,v->l,0,.92f);}int cap=g_perf80_quality==0?7:(g_perf80_quality==1?12:18);float maxD=g_perf80_quality==0?68.0f:(g_perf80_quality==1?95.0f:125.0f),d2max=maxD*maxD;for(int i=0;i<g_traffic_count&&cap>0;i++){Traffic*t=&g_traffic[i];if(!t->active)continue;float dx=t->p.x-g_player.body.p.x,dz=t->p.z-g_player.body.p.z,d2=dx*dx+dz*dz;if(d2>d2max)continue;int model=(i*5+i/3)&7;const CarVisual160*v=&g_car_visual160[model];float fade=.45f+.55f*(1.0f-clampf((float)sqrt((double)d2)/maxD,0,1));V3 tp=t->p;tp.y+=.10f;if(lights)vlight500_pair(tp,t->yaw,v->w,v->l,1,.55f*fade);if(g_traffic_brake_amount[i]>.12f)vlight500_pair(tp,t->yaw,v->w,v->l,0,.66f*fade);cap--;}glEnd();glDepthMask(TRUE);glDisable(GL_BLEND);renderer09_resume_shader();if(g_vlight500_front||g_vlight500_brake)g_draw_calls++;}
static void vehiclelights500_overlay(void){if(!g_debug||g_settings_menu_open||(g_photo70&&g_photo70_hide_hud))return;settings_draw_2d_begin();char b[120];sprintf(b,"VEH LIGHT 5.0 // front %d | brake %d",g_vlight500_front,g_vlight500_brake);gl_text((float)g_w-462,146,b,.88f,.55f,.42f);settings_draw_2d_end();}
