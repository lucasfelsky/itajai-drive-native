// -----------------------------------------------------------------------------
// 5.0 activity presentation: world start/finish beacons, compact event HUD and
// full-map activity markers. Rendered UI stays at native resolution after HDR.
// -----------------------------------------------------------------------------
static void event500_ring(V3 p,float radius,float y,float r,float g,float b,float a){renderer09_suspend_shader();glDisable(GL_TEXTURE_2D);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);glColor4f(r,g,b,a);glLineWidth(2.4f);glBegin(GL_LINES);for(int k=0;k<32;k++){float a0=k*6.2831853f/32.0f,a1=(k+1)*6.2831853f/32.0f;glVertex3f(p.x+(float)cos(a0)*radius,y,p.z+(float)sin(a0)*radius);glVertex3f(p.x+(float)cos(a1)*radius,y,p.z+(float)sin(a1)*radius);}glEnd();glLineWidth(1);glDisable(GL_BLEND);renderer09_resume_shader();}
static void events500_draw_world(void){if(!g_started||g_map380_open)return;event500_init();float pulse=.5f+.5f*(float)sin(g_time*3.0);if(g_event500_active>=0){V3 p=project_geo(g_event500_defs[g_event500_active].flat,g_event500_defs[g_event500_active].flon);float d=event500_dist(g_player.body.p,p);if(d<1200){float y=terrain11_height(p.x,p.z)+.15f;event500_ring(p,7.0f+pulse*1.2f,y,.10f,.78f,1.0f,.88f);renderer09_suspend_shader();identity150_text3d(v3(p.x-4.0f,y+5.4f,p.z),"CHEGADA",.18f,.88f,1.0f);renderer09_resume_shader();}return;}for(int i=0;i<EVENT500_COUNT;i++){V3 p=project_geo(g_event500_defs[i].slat,g_event500_defs[i].slon);float d=event500_dist(g_player.body.p,p);if(d>720)continue;float y=terrain11_height(p.x,p.z)+.15f;event500_ring(p,5.0f+pulse*.8f,y,.96f,.68f,.13f,.80f);if(d<95){renderer09_suspend_shader();identity150_text3d(v3(p.x-6.0f,y+4.0f,p.z),g_event500_defs[i].name,1.0f,.78f,.26f);renderer09_resume_shader();}}}
static void events500_draw_hud(void){if(!g_started||g_settings_menu_open||g_map380_open||g_garage215_open||(g_photo70&&g_photo70_hide_hud))return;event500_init();settings_draw_2d_begin();char b[240];if(g_event500_active>=0){float w=410,x=(g_w-w)*.5f,y=110;hud_panel(x,y,w,92);sprintf(b,"%s",g_event500_defs[g_event500_active].name);gl_text(x+18,y+25,b,1.0f,.82f,.32f);sprintf(b,"TEMPO  %02d:%05.2f    ALVO  %02d:%05.2f",(int)g_event500_time/60,g_event500_time-(int)(g_event500_time/60)*60,(int)g_event500_target/60,g_event500_target-(int)(g_event500_target/60)*60);gl_text(x+18,y+51,b,.82f,.91f,1.0f);sprintf(b,"%.1f km restantes  //  F4 abandonar",g_nav400_remaining/1000.0f);gl_text(x+18,y+75,b,.62f,.73f,.82f);}else if(g_event500_near>=0){float w=470,x=(g_w-w)*.5f,y=(float)g_h-122;hud_panel(x,y,w,72);sprintf(b,"%s   //   F4 INICIAR",g_event500_defs[g_event500_near].name);gl_text(x+18,y+28,b,1.0f,.80f,.30f);float best=g_event500_save.best[g_event500_near];if(best>0)sprintf(b,"MELHOR %.1fs   |   premio base %d CR",best,g_event500_defs[g_event500_near].reward);else sprintf(b,"NOVO EVENTO   |   premio base %d CR",g_event500_defs[g_event500_near].reward);gl_text(x+18,y+52,b,.68f,.80f,.88f);}if(g_drift500_live>0||g_drift500_score>20){sprintf(b,"DRIFT  %.0f",g_drift500_score);gl_text(28,(float)g_h*.43f,b,1.0f,.72f,.24f);}if(g_event500_result_timer>0){if(g_event500_last_result<0)sprintf(b,"EVENTO CANCELADO");else sprintf(b,"RESULTADO  +%d",g_event500_last_result);gl_text((float)g_w*.5f-95,86,b,1.0f,.83f,.34f);}sprintf(b,"%d CR   //   REP %d",g_event500_save.credits,g_event500_save.rep);gl_text(24,(float)g_h-24,b,.55f,.68f,.78f);settings_draw_2d_end();}
static void events500_draw_map(void){if(!g_map380_open)return;event500_init();settings_draw_2d_begin();for(int i=0;i<EVENT500_COUNT;i++){V3 p=project_geo(g_event500_defs[i].slat,g_event500_defs[i].slon);if(!map380_visible(p,18))continue;float x,y;map380_world_to_screen(p,&x,&y);map380_marker(x,y,5.5f,1.0f,.68f,.16f);if(g_map380_range<2500)gl_text(x+8,y-6,g_event500_defs[i].name,.48f,.70f,.84f);}V3 s=g_event500_speedtrap;if(map380_visible(s,18)){float x,y;map380_world_to_screen(s,&x,&y);map380_marker(x,y,4.0f,.95f,.34f,.18f);if(g_map380_range<2200)gl_text(x+7,y-5,"RADAR DE VELOCIDADE",.48f,.72f,.80f);}settings_draw_2d_end();}
